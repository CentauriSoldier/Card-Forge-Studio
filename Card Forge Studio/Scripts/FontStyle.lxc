        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawGlow
        @desc Draws enabled glow layers before the main text.
        @param any sObject Object.
        @param any D D.
        @param any hInternalDC H internal dc.
        @param any nX X.
        @param any nY Y.
        @param any sText Text.
        @param any nAngle Angle.
        @vis private
        !]]
        private DrawGlow(sObject, D, hInternalDC, nX, nY, sText, nAngle)
        {
            local pri = this;
            local nRadius = math.max(0, FontStyle.floor(pri.GlowRadius));
            local nAlphaMax = FontStyle.clamp(FontStyle.floor(pri.GlowAlphaMax), 0, 255);
            if (nRadius == 0 or nAlphaMax == 0) then return; end
            local nInner = pri.GlowColor;
            local nOuter = pri.GlowGradientEnabled and pri.GlowOuterColor or nInner;
            -- Sample translucent rings behind the glyphs. Outer rings fade out;
            -- per-sample opacity avoids making the overlapping passes opaque.
            for nDistance = nRadius, 1, -1 do
                local nMix = nDistance / nRadius;
                --[[!
                @fqxn CFS.Classes.FontStyle.Private.Functions.channel
                @desc Extracts a color channel for glow interpolation.
                @param any fChannel Channel.
                @vis private
                !]]
                local function channel(fChannel)
                    return FontStyle.floor(fChannel(nInner) * (1 - nMix) + fChannel(nOuter) * nMix + 0.5);
                end
                local nSamples = math.min(32, math.max(8, math.ceil(2 * math.pi * nDistance)));
                local nAlpha = FontStyle.floor(nAlphaMax * (channel(FontStyle._tColor.GetAlpha) / 255) * math.exp(-2 * nMix * nMix) / nSamples + 0.5);
                if (nAlpha > 0) then
                    local nColor = FontStyle._tColor.RGBA(channel(FontStyle._tColor.GetRed), channel(FontStyle._tColor.GetGreen), channel(FontStyle._tColor.GetBlue), nAlpha);
                    for nSample = 0, nSamples - 1 do
                        local nRadians = 2 * math.pi * nSample / nSamples;
                        local nDrawX = nX + math.cos(nRadians) * nDistance;
                        local nDrawY = nY + math.sin(nRadians) * nDistance;
                        if (nAngle) then
                            FontStyle.DrawTextRun(pri, D, nDrawX, nDrawY, sText, nAngle, nColor);
                        else
                            FontStyle.DrawTextRun(pri, D, nDrawX, nDrawY, sText, nil, nColor);
                        end
                    end
                end
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.Draw3D
        @desc Draws extrusion layers using the configured depth, step, and color.
        @param any sObject Object.
        @param any D D.
        @param any hInternalDC H internal dc.
        @param any nX X.
        @param any nY Y.
        @param any sText Text.
        @param any nAngle Angle.
        @vis private
        !]]
        private Draw3D(sObject, D, hInternalDC, nX, nY, sText, nAngle)
        {
            local pri = this;
            local nER = FontStyle._tColor.GetRed(pri.D3Color);
            local nEG = FontStyle._tColor.GetGreen(pri.D3Color);
            local nEB = FontStyle._tColor.GetBlue(pri.D3Color);
            local nI = 0;
            local nAlpha = 0;
            local o3DCol = nil;

            for nI = pri.D3Depth, 1, -1 do
                nAlpha = FontStyle.clamp(20 + (nI * 12), 0, 255);
                o3DCol = FontStyle._tColor.RGBA(nER, nEG, nEB, nAlpha);

                FontStyle.DrawTextRun(pri, D, FontStyle.floor(nX + nI * pri.D3StepX), FontStyle.floor(nY + nI * pri.D3StepY), sText, nAngle, o3DCol);

            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawOutline
        @desc Draws text offsets using the configured outline thickness and color.
        @param any sObject Object.
        @param any D D.
        @param any hInternalDC H internal dc.
        @param any nX X.
        @param any nY Y.
        @param any sText Text.
        @param any nAngle Angle.
        @vis private
        !]]
        private DrawOutline(sObject, D, hInternalDC, nX, nY, sText, nAngle)
        {
            local pri = this;
            local nBaseX = 0;
            local nBaseY = 0;
            local nRadius = 0;
            local nRadius2 = 0;
            local nDY = 0;
            local nDX = 0;
            local nD2 = 0;

            if not (FontStyle.isnumber(pri.OutlineThickness) and pri.OutlineThickness > 0) then
                return;
            end

            nBaseX = FontStyle.floor(nX);
            nBaseY = FontStyle.floor(nY);
            nRadius = FontStyle.floor(pri.OutlineThickness);
            nRadius2 = nRadius * nRadius;

            for nDY = -nRadius, nRadius do
                for nDX = -nRadius, nRadius do
                    nD2 = (nDX * nDX) + (nDY * nDY);

                    if (nD2 > 0 and nD2 <= nRadius2) then
                        if (nAngle) then
                            FontStyle.DrawTextRun(pri, D, nBaseX + nDX, nBaseY + nDY, sText, nAngle, pri.OutlineColor);
                        else
                            FontStyle.DrawTextRun(pri, D, nBaseX + nDX, nBaseY + nDY, sText, nil, pri.OutlineColor);
                        end
                    end
                end
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawShadow
        @desc Draws the configured text shadow before the main text.
        @param any sObject Object.
        @param any D D.
        @param any hInternalDC H internal dc.
        @param any nX X.
        @param any nY Y.
        @param any sText Text.
        @param any nAngle Angle.
        @vis private
        !]]
        private DrawShadow(sObject, D, hInternalDC, nX, nY, sText, nAngle)
        {
            local pri = this;
            local nBaseX = FontStyle.floor(nX + pri.ShadowX);
            local nBaseY = FontStyle.floor(nY + pri.ShadowY);
            local nSR = FontStyle._tColor.GetRed(pri.ShadowColor);
            local nSG = FontStyle._tColor.GetGreen(pri.ShadowColor);
            local nSB = FontStyle._tColor.GetBlue(pri.ShadowColor);
            local nRadius = pri.ShadowRadius;
            local nShadowAlpha = FontStyle._tColor.GetAlpha(pri.ShadowColor);
            local oBlurCol = FontStyle._tColor.RGBA(nSR, nSG, nSB, FontStyle.clamp(nShadowAlpha, 0, 255));
            local nDY = 0;
            local nDX = 0;

            for nDY = -nRadius, nRadius do
                for nDX = -nRadius, nRadius do
                    if ((nDX * nDX) + (nDY * nDY)) <= (nRadius * nRadius) then
                        local nWeight = nRadius == 0 and 1 or math.exp(-2 * (nDX * nDX + nDY * nDY) / (nRadius * nRadius));
                        if (pri.ShadowSoftness) then
                            oBlurCol = FontStyle._tColor.RGBA(nSR, nSG, nSB, FontStyle.floor(nShadowAlpha * nWeight / math.max(1, nRadius * nRadius)));
                        end
                        if (nAngle) then
                            FontStyle.DrawTextRun(pri, D, nBaseX + nDX, nBaseY + nDY, sText, nAngle, oBlurCol);
                        else
                            FontStyle.DrawTextRun(pri, D, nBaseX + nDX, nBaseY + nDY, sText, nil, oBlurCol);
                        end
                    end
                end
            end
        }

        --PUBLIC
                --[[!
                @fqxn CFS.Classes.FontStyle.Methods.FontStyle
                @pulsarlua function FontStyle
                @desc Constructs a named font-style instance and applies supplied parsed settings.
                @param any sName Name.
                @param any tParsed Parsed.
                @ret FontStyle Created instance.
                !]]
        public FontStyle(sName, tParsed)
        {
            local pri = this;

            pri.Name = FontStyle.isstring(sName) and sName:upper() or "";

            if (FontStyle.istable(tParsed)) then
                this.ApplyParsed(tParsed, true);
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.ApplyParsed
        @pulsarlua function FontStyle.ApplyParsed
        @desc Applies parsed font and effect settings, rebuilding the native font when requested or absent.
        @param any tParsed Parsed.
        @param any bRebuildFont Rebuild font.
        !]]
        public ApplyParsed(tParsed, bRebuildFont)
        {
            local pri = this;
            local tFontOptions = {};
            local sFontFamily = "";
            local nFontSize = 12;

            if (FontStyle.istable(tParsed)) then
                tFontOptions = FontStyle.istable(tParsed.FontOptions) and clone(tParsed.FontOptions) or {};
                sFontFamily  = FontStyle.isstring(tParsed.FontFamily) and tParsed.FontFamily or "Times New Roman";
                nFontSize    = FontStyle.isnumber(tParsed.FontSize) and tParsed.FontSize or 12;

                if (bRebuildFont or not pri.Font) then
                    pri.Font = FontStyle.DrawingFont.Load(sFontFamily, nFontSize, {
                        Bold        = tFontOptions.Bold,
                        Italic      = tFontOptions.Italic,
                        Underline   = tFontOptions.Underline,
                        StrikeOut   = tFontOptions.StrikeOut,
                        HQ          = tFontOptions.HQ,
                    });
                end

                pri.Color               = tParsed.FontColor or FontStyle._oBlack;
                pri.ColorPath           = tParsed.FontColorPath or "";
                pri.LetterSpacing       = tParsed.LetterSpacing or 0;
                pri.BackgroundEnabled   = tParsed.BackgroundEnabled and true or false;
                pri.BackgroundColor     = tParsed.BackgroundColor or FontStyle._oClear;
                pri.BackgroundPadding   = math.max(0, tParsed.BackgroundPadding or 0);
                pri.ShadowRadius        = math.max(0, FontStyle.floor(tParsed.ShadowRadius or 2));
                pri.ShadowSoftness      = tParsed.ShadowSoftness ~= false;

                pri.ShadowEnabled       = tParsed.ShadowEnabled and true or false;
                pri.ShadowX             = FontStyle.floor(tParsed.ShadowX or 0);
                pri.ShadowY             = FontStyle.floor(tParsed.ShadowY or 0);
                pri.ShadowColor         = tParsed.ShadowColor or FontStyle._oClear;

                pri.D3Enabled           = tParsed.D3Enabled and true or false;
                pri.D3Depth             = FontStyle.floor(tParsed.D3Depth or 0);
                pri.D3StepX             = FontStyle.floor(tParsed.D3StepX or 0);
                pri.D3StepY             = FontStyle.floor(tParsed.D3StepY or 0);
                pri.D3Color             = tParsed.D3Color or FontStyle._oClear;

                -- Glow is rendered before the other text effects.
                pri.GlowEnabled         = tParsed.GlowEnabled and true or false;
                pri.GlowGradientEnabled = tParsed.GlowGradientEnabled and true or false;
                pri.GlowColor           = tParsed.GlowColor or FontStyle._oClear;
                pri.GlowOuterColor      = tParsed.GlowOuterColor or FontStyle._oClear;
                pri.GlowRadius          = FontStyle.floor(tParsed.GlowRadius or 0);
                pri.GlowAlphaMax        = FontStyle.floor(tParsed.GlowAlphaMax or 0);

                pri.OutlineEnabled      = tParsed.OutlineEnabled and true or false;
                pri.OutlineThickness    = FontStyle.floor(tParsed.OutlineThickness or 0);
                pri.OutlineColor        = tParsed.OutlineColor or FontStyle._oClear;
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.Update
        @pulsarlua function FontStyle.Update
        @desc Reparses the named style and updates the instance only when font or effect signatures change.
        !]]
        public Update()
        {
            local sName = this.Name;
            local tParsed = nil;
            local sFontSig = "";
            local sEffectSig = "";
            local tMeta = nil;
            local bFontChanged = false;
            local bEffectChanged = false;
            local bRet = false;

            tParsed = FontStyle.ParseFontStyleINI(sName);

            if (FontStyle.istable(tParsed)) then
                sFontSig = FontStyle.BuildFontSignature(tParsed);
                sEffectSig = FontStyle.BuildEffectSignature(tParsed);
                tMeta = FontStyle._tStyleMeta[sName];

                bFontChanged = not (tMeta) or tMeta.FontSig ~= sFontSig;
                bEffectChanged = not (tMeta) or tMeta.EffectSig ~= sEffectSig;

                if (bFontChanged or bEffectChanged) then
                    this.ApplyParsed(tParsed, bFontChanged);
                    FontStyle._tStyleMeta[sName] = {
                        FontSig   = sFontSig,
                        EffectSig = sEffectSig,
                    };
                    FontStyle._tParsedStyles[sName] = tParsed;
                    bRet = true;
                end

            end

            return bRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.Draw
        @pulsarlua function FontStyle.Draw
        @desc Draws the text background and enabled glow, shadow, extrusion, and outline layers before the main text.
        @param any sObject Object.
        @param any D D.
        @param any hInternalDC H internal dc.
        @param any nX X.
        @param any nY Y.
        @param any sText Text.
        @param any vAngle Angle.
        !]]
        public Draw(sObject, D, hInternalDC, nX, nY, sText, vAngle)
        {
            local pri = this;
            local nAngle = FontStyle.isnumber(vAngle) and FontStyle.floor(FontStyle.clamp(vAngle, 0, 360)) or nil;
            local nColor = pri.Color;

            if (pri.ColorPath ~= "") then
                nColor = FontStyle.ResolveColor(pri.ColorPath) or FontStyle._oBlack;
            end

            D.SetDrawingFont(pri.Font);
            D.SetFilteringMode(DRAW_BLEND_ALPHABLEND, DRAW_BLEND_TEXT_TRANSPARENT);

            if (pri.BackgroundEnabled) then
                local nPadding = pri.BackgroundPadding;
                if (nAngle and D.DrawTextBackground) then
                    D.DrawTextBackground(nX, nY, FontStyle.MeasureTextRun(pri, D, sText), D.GetTextHeight(sText), nPadding, pri.BackgroundColor, nAngle);
                else
                    D.DrawRectangle(nX - nPadding, nY - nPadding,
                        FontStyle.MeasureTextRun(pri, D, sText) + 2 * nPadding, D.GetTextHeight(sText) + 2 * nPadding, pri.BackgroundColor);
                end
            end
            if (pri.GlowEnabled) then
                pri.DrawGlow(sObject, D, hInternalDC, nX, nY, sText, nAngle);
            end

            if (pri.ShadowEnabled) then
                pri.DrawShadow(sObject, D, hInternalDC, nX, nY, sText, nAngle);
            end

            if (pri.D3Enabled) then
                pri.Draw3D(sObject, D, hInternalDC, nX, nY, sText, nAngle);
            end

            if (pri.OutlineEnabled) then
                pri.DrawOutline(sObject, D, hInternalDC, nX, nY, sText, nAngle);
            end

            if (nAngle) then
                FontStyle.DrawTextRun(pri, D, nX, nY, sText, nAngle, nColor);
            else
                FontStyle.DrawTextRun(pri, D, nX, nY, sText, nil, nColor);
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.Prep
        @pulsarlua function FontStyle.Prep
        @desc Measures text and effect extents and optionally installs the style's font in the drawing context.
        @param any D D.
        @param any sText Text.
        @param any bSkipSetFont Skip set font.
        !]]
        public Prep(D, sText, bSkipSetFont)
        {
            local pri = this;
            local nTextWidth = 0;
            local nTextHeight = 0;
            local nMinX = 0;
            local nMinY = 0;
            local nTotalW = 0;
            local nTotalH = 0;

            if not (bSkipSetFont) then
                D.SetDrawingFont(pri.Font);
                D.SetFilteringMode(DRAW_BLEND_ALPHABLEND, DRAW_BLEND_TEXT_TRANSPARENT);
            end

            nTextWidth = FontStyle.MeasureTextRun(pri, D, sText);
            nTextHeight = D.GetTextHeight(sText);

            nMinX, nMinY, nTotalW, nTotalH =
                FontStyle.GetEffectBounds(
                    nTextWidth, nTextHeight,
                    pri.ShadowEnabled, pri.ShadowX, pri.ShadowY,
                    pri.D3Enabled, pri.D3StepX, pri.D3StepY, pri.D3Depth,
                    pri.GlowEnabled, pri.GlowRadius
                );

            local nPadding = pri.BackgroundEnabled and pri.BackgroundPadding or 0;
            local nShadowRadius = pri.ShadowEnabled and pri.ShadowRadius or 0;
            local nOutlineRadius = pri.OutlineEnabled and pri.OutlineThickness or 0;
            local nExtra = math.max(nPadding, nShadowRadius, nOutlineRadius);
            nMinX, nMinY = nMinX - nExtra, nMinY - nExtra;
            nTotalW, nTotalH = nTotalW + 2 * nExtra, nTotalH + 2 * nExtra;
            return nTotalW, nTotalH, nMinX, nMinY;
        }
    }
}
