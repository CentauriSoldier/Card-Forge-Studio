--[[!
@fqxn CFS.Classes.FontStyle
@desc
<section aria-label="Font Style overview">
<div style="padding:1.6rem;border:1px solid var(--border);border-radius:16px;background:linear-gradient(135deg,var(--surface-raised),var(--surface));margin-bottom:1.5rem"><p style="margin:0;color:var(--accent);font-weight:700;letter-spacing:.08em">CARD FORGE STUDIO · OVERVIEW</p><h2 style="margin:.5rem 0">Font Style</h2><p style="font-size:1.15rem;margin:0">FontStyle gives card text a reusable visual identity.</p></div>
<h3>How it fits into your work</h3><p>Define styles in the game's style INI file, preview them in Style Editor, and use them when drawing text. Inherited settings let one style build on another instead of repeating every choice.</p>
<h3>Follow the handoffs</h3><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1rem;margin:1rem 0">
<article style="padding:1.2rem;border:1px solid var(--border);border-radius:14px;background:var(--surface-raised);min-width:0"><h3 style="margin:0 0 .6rem;color:var(--accent)">One style, several places</h3><p style="margin:0">A named text style gathers the appearance choices used for lettering. Styles can inherit values from another style, so related text can share a foundation while changing selected details. The style reader resolves those values; Forge uses the result when drawing styled text.</p></article>
<article style="padding:1.2rem;border:1px solid var(--border);border-radius:14px;background:var(--surface-raised);min-width:0"><h3 style="margin:0 0 .6rem;color:var(--accent)">Where to make a change</h3><p style="margin:0">Edit the style definitions to change the named appearance, and use the style editor’s sample to inspect it. The card drawing script chooses which named style to use. FontStyle connects those definitions to rendering; it does not decide the card’s text, position, or data values for you.</p></article>
</div>
<h3>Explore the connected parts</h3><p>These topics explain the nearby pieces of the workflow. Follow a card to see the part it plays.</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1rem;margin:1rem 0">
<article style="padding:1.2rem;border:1px solid var(--border);border-radius:14px;background:var(--surface-raised);min-width:0"><h3 style="margin:0 0 .6rem;color:var(--accent)"><a href="#CFS.Windows.StyleEditor">StyleEditor</a></h3><p style="margin:0">The editor lets you adjust style drafts and see a live sample before saving.</p></article>
<article style="padding:1.2rem;border:1px solid var(--border);border-radius:14px;background:var(--surface-raised);min-width:0"><h3 style="margin:0 0 .6rem;color:var(--accent)"><a href="#CFS.Modules.Forge">Forge</a></h3><p style="margin:0">Forge uses FontStyle when drawing styled text onto a card.</p></article>
<article style="padding:1.2rem;border:1px solid var(--border);border-radius:14px;background:var(--surface-raised);min-width:0"><h3 style="margin:0 0 .6rem;color:var(--accent)"><a href="#CFS.Modules.ProcSys">Processing System</a></h3><p style="margin:0">ProcSys watches the game style file and responds when saved settings change.</p></article>
</div>
<aside style="padding:1rem 1.2rem;border-left:4px solid var(--accent);background:var(--surface);border-radius:0 10px 10px 0;margin:1.5rem 0"><strong>Good to know</strong><p style="margin:.4rem 0 0">Card text styling is separate from grid colors and the documentation website theme.</p></aside>
<p style="color:var(--muted)">Ready for the details? The child entries in the navigation describe individual methods, inputs, and results.</p>
</section>
!]]
namespace CFS
{
    class FontStyle
    {
        private static wx = require("wx");
        private static INI = require("Plugins.INI");
        private static clamp = math.clamp;
        private static floor = math.floor;
        private static isnumber = type.isnumber;
        private static isstring = type.isstring;
        private static istable = type.istable;
        private static _tColor = {
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.Color_RGBA
            @desc Packs red, green, blue, and alpha channels into an RGBA integer.
            @param any nR R.
            @param any nG G.
            @param any nB B.
            @param any nA A.
            @vis private
            !]]
            RGBA = function(nR, nG, nB, nA)
                return (nR << 24) | (nG << 16) | (nB << 8) | nA
            end,
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.Color_GetRed
            @desc Extracts the red byte from a packed RGBA value.
            @param any oColor Color.
            @vis private
            !]]
            GetRed = function(oColor)
                return (oColor >> 24) & 255
            end,
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.Color_GetGreen
            @desc Extracts the green byte from a packed RGBA value.
            @param any oColor Color.
            @vis private
            !]]
            GetGreen = function(oColor)
                return (oColor >> 16) & 255
            end,
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.Color_GetBlue
            @desc Extracts the blue byte from a packed RGBA value.
            @param any oColor Color.
            @vis private
            !]]
            GetBlue = function(oColor)
                return (oColor >> 8) & 255
            end,
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.Color_GetAlpha
            @desc Extracts the alpha byte from a packed RGBA value.
            @param any oColor Color.
            @vis private
            !]]
            GetAlpha = function(oColor)
                return oColor & 255
            end,
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.Color_TryFromString
            @desc Parses supported color text into a packed RGBA value.
            @param any sValue Value.
            @vis private
            !]]
            TryFromString = function(sValue)
                if (rawtype(sValue) ~= "string") then return nil end

                local sText     = sValue:match("^%s*(.-)%s*$");
                local tChannels = {};

                if (sText:find(",", 1, true)) then
                    for sChannel in sText:gmatch("[^,]+") do
                        local nChannel = tonumber(sChannel);
                        if (not nChannel or nChannel < 0 or nChannel > 255) then return nil end
                        tChannels[#tChannels + 1] = nChannel;
                    end

                    if (#tChannels == 3 or #tChannels == 4) then
                        return FontStyle._tColor.RGBA(tChannels[1], tChannels[2], tChannels[3], tChannels[4] or 255);
                    end
                    return nil;
                end

                local sHex = sText:gsub("^#", "");

                if ((#sHex == 6 or #sHex == 8) and sHex:match("^%x+$")) then
                    return FontStyle._tColor.RGBA(tonumber(sHex:sub(1, 2), 16), tonumber(sHex:sub(3, 4), 16), tonumber(sHex:sub(5, 6), 16), #sHex == 8 and tonumber(sHex:sub(7, 8), 16) or 255);
                end

                return nil;
            end
        };
        private static DrawingFont = {
            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.DrawingFont_Load
            @desc Creates a native font with the requested family, size, and style flags.
            @param any sFamily Family.
            @param any nSize Size.
            @param any tOptions Options.
            @vis private
            !]]
            Load = function(sFamily, nSize, tOptions)
                local oFont = FontStyle.wx.wxFont(nSize, FontStyle.wx.wxFONTFAMILY_DEFAULT, tOptions.Italic and FontStyle.wx.wxFONTSTYLE_ITALIC or FontStyle.wx.wxFONTSTYLE_NORMAL, tOptions.Bold and FontStyle.wx.wxFONTWEIGHT_BOLD or FontStyle.wx.wxFONTWEIGHT_NORMAL, tOptions.Underline or false, sFamily);

                if (tOptions.StrikeOut) then
                    oFont:SetStrikethrough(true);
                end

                return oFont;
            end
        };
        private static _oBlack = FontStyle._tColor.RGBA(0, 0, 0, 255);
        private static _oClear = FontStyle._tColor.RGBA(0, 0, 0, 0);
        private static _tState = {TimerID = FONTSTYLE_TIMER_ID, TimerInterval = FONTSTYLE_TIMER_INTERVAL, TimerBusy = false, LiveFileRepo = nil, FontStylesChanged = false, INI = nil};
        private static _tStyles = {};
        private static _tStyleMeta = {};
        private static _tParsedStyles = {};

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.Ini
        @desc Creates an INI-reader adapter for style sections and inherited values.
        @param any pFile File.
        @param boolean bCaseSensitive Optional; defaults to true. False matches section/key names without case.
        @vis private
        !]]
        private static Ini(pFile, bCaseSensitive)
        {
            return FontStyle.INI.CreateReader(pFile, bCaseSensitive);
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.XPCallError
        @desc Formats a font-style error with a stack traceback.
        @param any vErr Err.
        @vis private
        !]]
        private static XPCallError(vErr)
        {
            return debug.traceback(tostring(vErr), 2);
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.GetEffectBounds
        @desc Computes text bounds including enabled shadow, extrusion, and glow offsets.
        @param any nW W.
        @param any nH H.
        @param any bShadow Shadow.
        @param any nShadowX Shadow x.
        @param any nShadowY Shadow y.
        @param any b3D B3d.
        @param any n3DStepX N3dstep x.
        @param any n3DStepY N3dstep y.
        @param any n3DDepth N3ddepth.
        @param any bGlow Glow.
        @param any nGlowRadius Glow radius.
        @vis private
        !]]
        private static GetEffectBounds(nW, nH,
    bShadow, nShadowX, nShadowY,
    b3D, n3DStepX, n3DStepY, n3DDepth, bGlow, nGlowRadius)
        {
            local nMinX = 0;
            local nMaxX = nW;
            local nMinY = 0;
            local nMaxY = nH;

            --[[!
            @fqxn CFS.Classes.FontStyle.Private.Functions.ApplyDelta
            @desc Extends effect bounds by a supplied horizontal and vertical offset.
            @param any nDX Dx.
            @param any nDY Dy.
            @vis private
            !]]
            local function ApplyDelta(nDX, nDY)
                local nX0 = nDX;
                local nX1 = nW + nDX;
                local nY0 = nDY;
                local nY1 = nH + nDY;

                nMinX = math.min(nMinX, nX0, nX1);
                nMaxX = math.max(nMaxX, nX0, nX1);
                nMinY = math.min(nMinY, nY0, nY1);
                nMaxY = math.max(nMaxY, nY0, nY1);
            end

            if (bShadow) then
                ApplyDelta(FontStyle.floor(nShadowX or 0), FontStyle.floor(nShadowY or 0));
            end

            if (b3D) then
                local nDepth = FontStyle.floor(n3DDepth or 0);
                ApplyDelta(
                    FontStyle.floor((n3DStepX or 0) * nDepth),
                    FontStyle.floor((n3DStepY or 0) * nDepth)
                );
            end

            if (bGlow) then
                local nRadius = math.max(0, FontStyle.floor(nGlowRadius or 0));
                ApplyDelta(-nRadius, -nRadius);
                ApplyDelta(nRadius, nRadius);
            end

            return nMinX, nMinY, nMaxX - nMinX, nMaxY - nMinY;
        }

        -- Gradient stops use position:#RRGGBB[AA], separated by semicolons.
        -- Positions increase strictly from 0 to 1; all styles use the same parser.
        public static ParseGradientStops(sValue)
        {
            local tStops = {};
            for sStop in (sValue..";"):gmatch("(.-);") do
                local sPosition, sHex = sStop:match("^%s*([%d%.]+)%s*:%s*#?(%x+)%s*$");
                local nPosition = tonumber(sPosition);
                assert(nPosition and nPosition >= 0 and nPosition <= 1 and (#sHex == 6 or #sHex == 8),
                    "GradientStops: use 0:#RRGGBB; 0.5:#RRGGBB; 1:#RRGGBB (optional alpha)." );
                assert(#tStops == 0 or nPosition > tStops[#tStops].Position, "Gradient stop positions must increase strictly.");
                local nColor = tonumber(sHex, 16);
                if (#sHex == 6) then nColor = (nColor << 8) | 255; end
                tStops[#tStops + 1] = {Position = nPosition, Color = nColor};
            end
            assert(#tStops >= 2 and tStops[1].Position == 0 and tStops[#tStops].Position == 1,
                "GradientStops requires at least two stops, starting at 0 and ending at 1.");
            return tStops;
        }

        -- Draw the main fill in clipped bands; effect layers keep their own colors.
        private static DrawGradientRun(pri, D, nX, nY, sText, nAngle)
        {
            local nWidth		= FontStyle.MeasureTextRun(pri, D, sText);
            local nHeight		= D.GetTextHeight(sText);
            local bHorizontal	= pri.GradientDirection == "Horizontal";
            local nLength		= bHorizontal and nWidth or nHeight;
            if (nLength <= 0 or sText == "") then return; end
            local tStops = pri.GradientStops;
            local nStop = 1;
            D.WithTextTransform(nX, nY, nAngle or 0, function()
                -- Extend the first/last color over glyph overhangs without cropping them.
                for nBand = -math.ceil(nHeight), math.ceil(nLength + nHeight) - 1 do
                    local nPosition = FontStyle.clamp((nBand + 0.5) / nLength, 0, 1);
                    while (nStop < #tStops - 1 and nPosition > tStops[nStop + 1].Position) do nStop = nStop + 1; end
                    local tLeft		= tStops[nStop];
                    local tRight	= tStops[nStop + 1];
                    local nMix		= (nPosition - tLeft.Position) / (tRight.Position - tLeft.Position);
                    local nColor	= 0;
                    for nShift = 24, 0, -8 do
                        local nLeft = (tLeft.Color >> nShift) & 255;
                        local nRight = (tRight.Color >> nShift) & 255;
                        nColor = nColor | (FontStyle.floor(nLeft + (nRight - nLeft) * nMix + 0.5) << nShift);
                    end
                    local nClipX	= bHorizontal and nBand or -nHeight;
                    local nClipY	= bHorizontal and -nHeight or nBand;
                    local nClipW	= bHorizontal and 1 or nWidth + 2 * nHeight;
                    local nClipH	= bHorizontal and 3 * nHeight or 1;
                    D.WithTextClip(nClipX, nClipY, nClipW, nClipH, function()
                        FontStyle.DrawTextRun(pri, D, 0, 0, sText, nil, nColor);
                    end);
                end
            end);
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.ParseBevelSettings
        @desc Validates Bevel/Emboss settings and builds a cache signature. Native pixel sizes
        follow text scaling. Light angle 0 points right, 90 up; edges are selected by their
        outward contour normals, independently of lighting. All edges default on. Raised
        and Inset stay inside the glyph; Emboss/Stamp also shade a padded outside contour.
        @param table tParsed Optional Bevel-prefixed settings (INI strings or parsed values).
        @ret table tBevel Normalized settings, Outside flag, padding and cache signature.
        !]]
        public static ParseBevelSettings(tParsed)
        {
            local function number(sKey, nDefault, nMin, nMax)
                local vValue	= tParsed["Bevel"..sKey];
                local nValue	= tonumber(vValue);
                if (vValue == nil or vValue == "") then nValue = nDefault; end
                assert(type(nValue) == "number" and nValue == nValue and nValue % 1 == 0 and nValue >= nMin and nValue <= nMax,
                    "Bevel"..sKey.." must be an integer from "..nMin.." to "..nMax..".");
                return nValue;
            end
            local function boolean(sKey, bDefault)
                local vValue = tParsed["Bevel"..sKey];
                if (vValue == nil or vValue == "") then return bDefault; end
                assert(vValue == true or vValue == false or vValue == "true" or vValue == "false", "Bevel"..sKey.." must be true or false.");
                return vValue == true or vValue == "true";
            end
            local function choice(sKey, sDefault, tChoices)
                local sValue = tParsed["Bevel"..sKey];
                if (sValue == nil or sValue == "") then sValue = sDefault; end
                for _, sChoice in ipairs(tChoices) do if (sChoice == sValue) then return sValue; end end
                error("Bevel"..sKey.." must be "..table.concat(tChoices, ", ")..".");
            end
            local function color(sKey, nDefault)
                local vValue = tParsed["Bevel"..sKey];
                if (vValue == nil or vValue == "") then return nDefault; end
                if (type(vValue) == "number") then
                    assert(vValue >= 0 and vValue <= 0xFFFFFFFF and vValue % 1 == 0, "Invalid Bevel"..sKey.." RGBA value.");
                    return vValue;
                end
                return assert(FontStyle._tColor.TryFromString(vValue, true), "Invalid Bevel"..sKey.." color.");
            end
            local tBevel			= {
                Enabled				= boolean("Enabled", false),
                Mode				= choice("Mode", "Raised", {"Raised", "Inset", "Emboss", "Stamp"}),
                Profile				= choice("Profile", "Chamfer", {"Chamfer", "Round", "Sharp"}),
                Width				= number("Width", 2, 1, 16),
                Depth				= number("Depth", 2, 1, 16),
                Softness			= number("Softness", 1, 0, 8),
                EdgeTop				= boolean("EdgeTop", true),
                EdgeBottom			= boolean("EdgeBottom", true),
                EdgeLeft			= boolean("EdgeLeft", true),
                EdgeRight			= boolean("EdgeRight", true),
                LightAngle			= number("LightAngle", 135, 0, 359),
                LightElevation		= number("LightElevation", 45, 0, 90),
                HighlightColor		= color("HighlightColor", 0xFFFFFFFF),
                ShadowColor			= color("ShadowColor", 0x101820FF),
                HighlightStrength	= number("HighlightStrength", 180, 0, 255),
                ShadowStrength		= number("ShadowStrength", 180, 0, 255),
                SpecularStrength	= number("SpecularStrength", 80, 0, 255),
                SpecularPower		= number("SpecularPower", 16, 1, 128),
                Opacity				= number("Opacity", 220, 0, 255),
            };
            tBevel.Outside = tBevel.Mode == "Emboss" or tBevel.Mode == "Stamp";
            tBevel.Padding = tBevel.Width + tBevel.Softness + 2;
            local tSignature = {};
            for _, sKey in ipairs({"Enabled", "Mode", "Profile", "Width", "Depth", "Softness", "EdgeTop", "EdgeBottom", "EdgeLeft", "EdgeRight",
                "LightAngle", "LightElevation", "HighlightColor", "ShadowColor", "HighlightStrength", "ShadowStrength", "SpecularStrength", "SpecularPower", "Opacity"}) do
                tSignature[#tSignature + 1] = tostring(tBevel[sKey]);
            end
            tBevel.Signature = table.concat(tSignature, ":");
            return tBevel;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.BevelShader
        @desc Creates a translucent highlight/shadow overlay from signed mask distances.
        It does not supply a replacement face color. Edge switches select contour-normal
        components (including curves); lighting is independent. Inset/Stamp reverse the
        surface slope. Emboss/Stamp add an outside rim; other modes preserve glyph coverage.
        @vis private
        !]]
        private static BevelShader(tBevel)
        {
            local nAzimuth		= math.rad(tBevel.LightAngle);
            local nElevation	= math.rad(tBevel.LightElevation);
            local nLightX		= math.cos(nAzimuth) * math.cos(nElevation);
            local nLightY		= -math.sin(nAzimuth) * math.cos(nElevation);
            local nLightZ		= math.sin(nElevation);
            local nHalfLength	= math.sqrt(nLightX * nLightX + nLightY * nLightY + (nLightZ + 1) ^ 2);
            local nHalfX		= nLightX / nHalfLength;
            local nHalfY		= nLightY / nHalfLength;
            local nHalfZ		= (nLightZ + 1) / nHalfLength;
            local nSign			= (tBevel.Mode == "Inset" or tBevel.Mode == "Stamp") and -1 or 1;
            return function(tMask, nX, nY)
                local nDistance	= tMask.SignedDistance(nX, nY);
                local nAlpha	= tMask.Alpha(nX, nY) / 255;
                local nInside	= nAlpha > 0;
                if (not nInside and not tBevel.Outside) then return 0, 0, 0, 0; end
                local nD = math.abs(nDistance);
                if (nInside) then nD = math.max(0, nDistance); end
                local nFade = FontStyle.clamp((tBevel.Width + tBevel.Softness / 2 - nD) / math.max(0.5, tBevel.Softness), 0, 1);
                if (nFade <= 0) then return 0, 0, 0, 0; end
                local nDX = (tMask.SignedDistance(nX + 1, nY - 1) + 2 * tMask.SignedDistance(nX + 1, nY) + tMask.SignedDistance(nX + 1, nY + 1)
                    - tMask.SignedDistance(nX - 1, nY - 1) - 2 * tMask.SignedDistance(nX - 1, nY) - tMask.SignedDistance(nX - 1, nY + 1)) / 8;
                local nDY = (tMask.SignedDistance(nX - 1, nY + 1) + 2 * tMask.SignedDistance(nX, nY + 1) + tMask.SignedDistance(nX + 1, nY + 1)
                    - tMask.SignedDistance(nX - 1, nY - 1) - 2 * tMask.SignedDistance(nX, nY - 1) - tMask.SignedDistance(nX + 1, nY - 1)) / 8;
                local nNormalLength = math.sqrt(nDX * nDX + nDY * nDY);
                if (nNormalLength < 0.0001) then return 0, 0, 0, 0; end
                local nOutX		= -nDX / nNormalLength;
                local nOutY		= -nDY / nNormalLength;
                local nSelected	= (tBevel.EdgeLeft and math.max(0, -nOutX) or 0) + (tBevel.EdgeRight and math.max(0, nOutX) or 0)
                    + (tBevel.EdgeTop and math.max(0, -nOutY) or 0) + (tBevel.EdgeBottom and math.max(0, nOutY) or 0);
                nSelected = nSelected / (math.abs(nOutX) + math.abs(nOutY));
                if (nSelected <= 0) then return 0, 0, 0, 0; end
                local nPosition	= FontStyle.clamp(nD / tBevel.Width, 0, 1);
                local nSlope	= tBevel.Depth / tBevel.Width;
                if (tBevel.Profile == "Round") then nSlope = nSlope * math.pi / 2 * math.cos(nPosition * math.pi / 2);
                elseif (tBevel.Profile == "Sharp") then nSlope = nSlope * 3 * (1 - nPosition) ^ 2; end
                nSlope				= nSlope * nSign;
                local nLength		= math.sqrt(nSlope * nSlope + 1);
                local nNX			= nOutX * nSlope / nLength;
                local nNY			= nOutY * nSlope / nLength;
                local nNZ			= 1 / nLength;
                local nDiffuse		= nNX * nLightX + nNY * nLightY + nNZ * nLightZ - nLightZ;
                local nSpecular		= math.max(0, nNX * nHalfX + nNY * nHalfY + nNZ * nHalfZ) ^ tBevel.SpecularPower;
                local nCoverage		= (nInside and nAlpha or 1 - nAlpha) * nFade * nSelected * tBevel.Opacity / 255;
                local nHighlight	= FontStyle.clamp((math.max(0, nDiffuse) * tBevel.HighlightStrength + nSpecular * tBevel.SpecularStrength) / 255, 0, 1)
                    * (tBevel.HighlightColor & 255) / 255 * nCoverage;
                local nShadow = FontStyle.clamp(math.max(0, -nDiffuse) * tBevel.ShadowStrength / 255, 0, 1)
                    * (tBevel.ShadowColor & 255) / 255 * nCoverage;
                local nTotal = nHighlight + nShadow * (1 - nHighlight);
                if (nTotal <= 0) then return 0, 0, 0, 0; end
                local function channel(nShift)
                    local nLight	= (tBevel.HighlightColor >> nShift) & 255;
                    local nDark		= (tBevel.ShadowColor >> nShift) & 255;
                    return FontStyle.clamp((nLight * nHighlight + nDark * nShadow * (1 - nHighlight)) / nTotal, 0, 255);
                end
                return channel(24), channel(16), channel(8), nTotal * 255;
            end;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawBevelRun
        @desc Reuses the native TextEffects mask/cache internally, without looking up or
        registering a named effect. The cached overlay includes every normalized Bevel
        setting in its identity. Cropped mask offsets preserve text origins and overhangs.
        The caller's rotation/scaling remains active; the cached bitmap is not owned here.
        @vis private
        !]]
        private static DrawBevelRun(pri, D, nX, nY, sText, nAngle)
        {
            local tBevel = pri.Bevel;
            if (not tBevel.Enabled or tBevel.Opacity == 0 or not sText:find("%S") or
                not (tBevel.EdgeTop or tBevel.EdgeBottom or tBevel.EdgeLeft or tBevel.EdgeRight)) then return; end
            local tRenderer	= require("TextEffects");
            local tEffect	= {Padding = tBevel.Padding, NeedsSignedDistance = true, Shade = FontStyle.BevelShader(tBevel)};
            local oBitmap, nWidth, nHeight, nOffsetX, nOffsetY = tRenderer.Render(pri.Font, pri.LetterSpacing, sText,
                "\1StyleBevel\1"..tBevel.Signature, tEffect);
            if (oBitmap) then
                D.WithTextTransform(nX, nY, nAngle or 0, function()
                    D.DrawTextOverlay(oBitmap, nOffsetX, nOffsetY, nWidth, nHeight);
                end);
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.ParseWearSettings
        @desc Normalizes built-in Wear settings. Lengths are percentages of font line height;
        width/highlight offset are native text pixels and scale with fitted text. Density is
        approximate scratches per eight em-squares, bounded at 128 scratches per text run.
        A private seeded generator never changes the game's RNG. Wear colors support RGBA.
        @param table tParsed Parsed Style fields with optional Wear-prefixed settings.
        @ret table tWear Validated settings; missing fields use the same defaults as the editor.
        !]]
        public static ParseWearSettings(tParsed)
        {
            local function number(sKey, nDefault, nMin, nMax)
                local vValue	= tParsed["Wear"..sKey];
                local nValue	= tonumber(vValue);
                if (vValue == nil or vValue == "") then nValue = nDefault; end
                assert(type(nValue) == "number" and nValue == nValue and nValue % 1 == 0 and nValue >= nMin and nValue <= nMax,
                    "Wear"..sKey.." must be an integer from "..nMin.." to "..nMax..".");
                return nValue;
            end
            local tWear				= {
                Enabled				= tParsed.WearEnabled == true,
                Density				= number("Density", 18, 0, 100),
                Pattern				= tParsed.WearPattern ~= nil and tParsed.WearPattern ~= "" and tParsed.WearPattern or "Scratches",
                ChipSizeMin			= number("ChipSizeMin", 3, 1, 20),
                ChipSizeMax			= number("ChipSizeMax", 9, 1, 20),
                ChipRoughness		= number("ChipRoughness", 65, 0, 100),
                LengthMin			= number("LengthMin", 8, 1, 200),
                LengthMax			= number("LengthMax", 45, 1, 200),
                Width				= number("Width", 1, 1, 8),
                Angle				= number("Angle", -15, -180, 180),
                AngleSpread			= number("AngleSpread", 25, 0, 180),
                Opacity				= number("Opacity", 100, 0, 255),
                Color				= tParsed.WearColor or 0x302A20FF,
                HighlightEnabled	= tParsed.WearHighlightEnabled ~= false,
                HighlightColor		= tParsed.WearHighlightColor or 0xFFF4CBFF,
                HighlightOffset		= number("HighlightOffset", 1, 0, 8),
                Seed				= number("Seed", 1, 0, 2147483646),
            };
            assert(tWear.LengthMin <= tWear.LengthMax, "WearLengthMin must not exceed WearLengthMax.");
            assert(tWear.Pattern == "Scratches" or tWear.Pattern == "Chips" or tWear.Pattern == "Mixed", "WearPattern must be Scratches, Chips or Mixed.");
            assert(tWear.ChipSizeMin <= tWear.ChipSizeMax, "WearChipSizeMin must not exceed WearChipSizeMax.");
            return tWear;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawChipsRun
        @desc Distributes small irregular paint chips per non-space glyph, with stratified
        placement instead of word-wide random clustering. Chip dimensions are percentages
        of font height and capped relative to each glyph advance; they never form full
        scratch strokes. Dark chip interiors and optional offset exposed-metal edges use
        WearColor/HighlightColor. Original text coverage clips every chip. At most 512 chips
        are allocated proportionally across the glyphs; each chip has at most 12 row bands.
        @vis private
        !]]
        private static DrawChipsRun(pri, D, nX, nY, sText, nAngle)
        {
            local tWear		= pri.Wear;
            local nHeight	= D.GetTextHeight(sText);
            if (nHeight <= 0) then return; end
            local tGlyphs	= {};
            local sPrefix	= "";
            local nOffset	= 0;
            for _, nCodePoint in utf8.codes(sText) do
                local sCharacter	= utf8.char(nCodePoint);
                local nWidth		= D.GetTextWidth(sCharacter);
                sPrefix				= sPrefix..sCharacter;
                local nStart		= pri.LetterSpacing == 0 and D.GetTextWidth(sPrefix) - nWidth or nOffset;
                if (sCharacter:match("%S") and nWidth > 0) then
                    tGlyphs[#tGlyphs + 1] = {X = nStart, Width = nWidth};
                end
                nOffset = nOffset + nWidth + pri.LetterSpacing;
            end
            if (#tGlyphs == 0) then return; end
            local nState = tWear.Seed;
            for nIndex = 1, #sText do nState = (nState * 131 + sText:byte(nIndex)) % 2147483647; end
            local function random()
                nState = (nState * 48271 + 1) % 2147483647;
                return nState / 2147483647;
            end
            local function opacity(nColor)
                return (nColor & 0xFFFFFF00) | FontStyle.floor((nColor & 255) * tWear.Opacity / 255 + 0.5);
            end
            local nColor		= opacity(tWear.Color);
            local nHighlight	= opacity(tWear.HighlightColor);
            local nDensity		= tWear.Pattern == "Mixed" and tWear.Density / 2 or tWear.Density;
            local nBudget		= math.min(512, #tGlyphs * math.max(1, math.ceil(nDensity / 12)));
            D.WithTextTransform(nX, nY, nAngle or 0, function()
                for nGlyph, tGlyph in ipairs(tGlyphs) do
                    local nCount	= math.floor(nGlyph * nBudget / #tGlyphs) - math.floor((nGlyph - 1) * nBudget / #tGlyphs);
                    local nColumns	= math.max(1, math.ceil(math.sqrt(nCount * tGlyph.Width / nHeight)));
                    local nRows		= math.max(1, math.ceil(nCount / nColumns));
                    for nChip = 1, nCount do
                        local nColumn		= (nChip - 1) % nColumns;
                        local nRow			= math.floor((nChip - 1) / nColumns);
                        local nCenterX		= tGlyph.X + (nColumn + 0.25 + random() * 0.5) * tGlyph.Width / nColumns;
                        local nCenterY		= (nRow + 0.25 + random() * 0.5) * nHeight / nRows;
                        local nSize			= nHeight * (tWear.ChipSizeMin + random() * (tWear.ChipSizeMax - tWear.ChipSizeMin)) / 100;
                        local nWidth		= math.min(nSize, tGlyph.Width * 0.18);
                        local nTall			= math.min(nSize * (0.6 + random() * 0.6), nHeight * 0.12);
                        local nBands		= math.min(12, math.max(1, math.ceil(nTall)));
                        local nBandHeight	= nTall / nBands;
                        local tShape		= {};
                        for nBand = 1, nBands do
                            local nRough		= tWear.ChipRoughness / 100;
                            local nInsetLeft	= random() * nWidth * 0.4 * nRough;
                            local nInsetRight	= random() * nWidth * 0.4 * nRough;
                            tShape[nBand] = {X = nCenterX - nWidth / 2 + nInsetLeft,
                                Y		= nCenterY - nTall / 2 + (nBand - 1) * nBandHeight,
                                Width	= nWidth - nInsetLeft - nInsetRight};
                        end
                        local function chip(nFill, nOffset)
                            for _, tBand in ipairs(tShape) do
                                D.WithTextClip(tBand.X, tBand.Y + nOffset, tBand.Width, nBandHeight, function()
                                    FontStyle.DrawTextRun(pri, D, 0, 0, sText, nil, nFill);
                                end);
                            end
                        end
                        if (tWear.HighlightEnabled) then chip(nHighlight, tWear.HighlightOffset); end
                        chip(nColor, 0);
                    end
                end
            end);
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawWearRun
        @desc Adds deterministic dark scratches and optional offset highlights over the main
        fill only. Repainting the original text through each scratch clip confines wear to
        glyph coverage; shadows, outline, extrusion, glow and background are unchanged.
        Existing text transforms, fitting, spacing and alpha are preserved. Wear adds no
        external geometry, so text bounds remain unchanged. Scratch count and segmentation
        are bounded (128 scratches, at most 64 bands per stroke).
        @vis private
        !]]
        private static DrawWearRun(pri, D, nX, nY, sText, nAngle)
        {
            local tWear = pri.Wear;
            if (not tWear.Enabled or tWear.Density == 0 or tWear.Opacity == 0 or sText == "") then return; end
            if (tWear.Pattern ~= "Scratches") then
                FontStyle.DrawChipsRun(pri, D, nX, nY, sText, nAngle);
                if (tWear.Pattern == "Chips") then return; end
            end
            local nWidth	= FontStyle.MeasureTextRun(pri, D, sText);
            local nHeight	= D.GetTextHeight(sText);
            if (nWidth <= 0 or nHeight <= 0) then return; end
            local nState = tWear.Seed;
            for nIndex = 1, #sText do nState = (nState * 131 + sText:byte(nIndex)) % 2147483647; end
            local function random()
                nState = (nState * 48271 + 1) % 2147483647;
                return nState / 2147483647;
            end
            local function opacity(nColor)
                local nAlpha = FontStyle.floor((nColor & 255) * tWear.Opacity / 255 + 0.5);
                return (nColor & 0xFFFFFF00) | nAlpha;
            end
            local nScratchColor		= opacity(tWear.Color);
            local nHighlightColor	= opacity(tWear.HighlightColor);
            local nDensity			= tWear.Pattern == "Mixed" and tWear.Density / 2 or tWear.Density;
            local nCount			= math.min(128, math.ceil(nWidth / nHeight * nDensity / 8));
            D.WithTextTransform(nX, nY, nAngle or 0, function()
                for nScratch = 1, nCount do
                    local nStartX	= random() * nWidth;
                    local nStartY	= random() * nHeight;
                    local nLength	= nHeight * (tWear.LengthMin + random() * (tWear.LengthMax - tWear.LengthMin)) / 100;
                    local nRadians	= math.rad(tWear.Angle + (random() * 2 - 1) * tWear.AngleSpread);
                    local nDX		= math.cos(nRadians) * nLength;
                    local nDY		= math.sin(nRadians) * nLength;
                    -- Slice along the short axis to keep long shallow scratches inexpensive.
                    local bHorizontal	= math.abs(nDX) >= math.abs(nDY);
                    local nShort		= bHorizontal and math.abs(nDY) or math.abs(nDX);
                    local nBands		= math.min(64, math.max(1, math.ceil(nShort)));
                    local nStepX		= nDX / nBands;
                    local nStepY		= nDY / nBands;
                    local nClipW		= math.abs(nStepX) + tWear.Width;
                    local nClipH		= math.abs(nStepY) + tWear.Width;
                    local function stroke(nColor, nOffset)
                        for nBand = 0, nBands - 1 do
                            local nClipX	= nStartX + nBand * nStepX + math.min(0, nStepX);
                            local nClipY	= nStartY + nBand * nStepY + math.min(0, nStepY) + nOffset;
                            D.WithTextClip(nClipX, nClipY, nClipW, nClipH, function()
                                FontStyle.DrawTextRun(pri, D, 0, 0, sText, nil, nColor);
                            end);
                        end
                    end
                    if (tWear.HighlightEnabled) then stroke(nHighlightColor, tWear.HighlightOffset); end
                    stroke(nScratchColor, 0);
                end
            end);
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.DrawTextRun
        @desc Draws a text run using the configured spacing and rotation.
        @param any pri Pri.
        @param any D D.
        @param any nX X.
        @param any nY Y.
        @param any sText Text.
        @param any nAngle Angle.
        @param any nColor Color.
        @vis private
        !]]
        private static DrawTextRun(pri, D, nX, nY, sText, nAngle, nColor)
        {
            if (pri.LetterSpacing == 0) then
                if (nAngle) then D.DrawAngledText(nX, nY, sText, nAngle, nColor);
                else D.DrawText(nX, nY, sText, nColor); end
                return;
            end
            local nOffset = 0;
            local nRadians = math.rad(nAngle or 0);
            for _, nCodePoint in utf8.codes(sText) do
                local sCharacter = utf8.char(nCodePoint);
                local nDrawX = nX + math.cos(nRadians) * nOffset;
                local nDrawY = nY - math.sin(nRadians) * nOffset;
                if (nAngle) then D.DrawAngledText(nDrawX, nDrawY, sCharacter, nAngle, nColor);
                else D.DrawText(nDrawX, nDrawY, sCharacter, nColor); end
                nOffset = nOffset + D.GetTextWidth(sCharacter) + pri.LetterSpacing;
            end
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.MeasureTextRun
        @desc Measures a text run while accounting for configured letter spacing.
        @param any pri Pri.
        @param any D D.
        @param any sText Text.
        @vis private
        !]]
        private static MeasureTextRun(pri, D, sText)
        {
            if (pri.LetterSpacing == 0) then return D.GetTextWidth(sText); end
            local nWidth, nCount = 0, 0;
            for _, nCodePoint in utf8.codes(sText) do
                nWidth = nWidth + D.GetTextWidth(utf8.char(nCodePoint));
                nCount = nCount + 1;
            end
            return nWidth + math.max(0, nCount - 1) * pri.LetterSpacing;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.ReadStyleFile
        @desc Reads the active style file through the live-file repository.
        @vis private
        !]]
        private static ReadStyleFile()
        {
            local sRet = "";
            local hFile = nil;

            hFile = io.open(FS.Styles, "rb");

            if (hFile) then
                sRet = hFile:read("*a");
                hFile:close();
            end

            sRet = FontStyle.isstring(sRet) and sRet or "";
            return sRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.BuildFontSignature
        @desc Builds a comparison signature from parsed font settings.
        @param any tParsed Parsed.
        @vis private
        !]]
        private static BuildFontSignature(tParsed)
        {
            local tFontOptions = FontStyle.istable(tParsed.FontOptions) and tParsed.FontOptions or {};
            local sRet = "";

            sRet = table.concat({
                tostring(tParsed.FontFamily),
                tostring(tParsed.FontSize),
                tostring(tFontOptions.Bold),
                tostring(tFontOptions.Italic),
                tostring(tFontOptions.Underline),
                tostring(tFontOptions.StrikeOut),
                tostring(tFontOptions.HQ),
            }, "\31");

            return sRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.BuildEffectSignature
        @desc Builds a comparison signature from parsed text-effect settings.
        @param any tParsed Parsed.
        @vis private
        !]]
        private static BuildEffectSignature(tParsed)
        {
            local sRet = "";

            sRet = table.concat({
                tostring(tParsed.FontColor),
                tostring(tParsed.FontColorPath),
                tostring(tParsed.GradientEnabled),
                tostring(tParsed.GradientStopsText),
                tostring(tParsed.GradientDirection),
                tostring(tParsed.BevelEnabled),
                tostring(tParsed.BevelMode),
                tostring(tParsed.BevelProfile),
                tostring(tParsed.BevelWidth),
                tostring(tParsed.BevelDepth),
                tostring(tParsed.BevelSoftness),
                tostring(tParsed.BevelEdgeTop),
                tostring(tParsed.BevelEdgeBottom),
                tostring(tParsed.BevelEdgeLeft),
                tostring(tParsed.BevelEdgeRight),
                tostring(tParsed.BevelLightAngle),
                tostring(tParsed.BevelLightElevation),
                tostring(tParsed.BevelHighlightColor),
                tostring(tParsed.BevelShadowColor),
                tostring(tParsed.BevelHighlightStrength),
                tostring(tParsed.BevelShadowStrength),
                tostring(tParsed.BevelSpecularStrength),
                tostring(tParsed.BevelSpecularPower),
                tostring(tParsed.BevelOpacity),
                tostring(tParsed.WearEnabled),
                tostring(tParsed.WearDensity),
                tostring(tParsed.WearLengthMin),
                tostring(tParsed.WearLengthMax),
                tostring(tParsed.WearWidth),
                tostring(tParsed.WearAngle),
                tostring(tParsed.WearAngleSpread),
                tostring(tParsed.WearOpacity),
                tostring(tParsed.WearColor),
                tostring(tParsed.WearHighlightEnabled),
                tostring(tParsed.WearHighlightColor),
                tostring(tParsed.WearHighlightOffset),
                tostring(tParsed.WearPattern),
                tostring(tParsed.WearChipSizeMin),
                tostring(tParsed.WearChipSizeMax),
                tostring(tParsed.WearChipRoughness),
                tostring(tParsed.WearSeed),
                tostring(tParsed.LetterSpacing),
                tostring(tParsed.BackgroundEnabled),
                tostring(tParsed.BackgroundColor),
                tostring(tParsed.BackgroundPadding),
                tostring(tParsed.ShadowRadius),
                tostring(tParsed.ShadowSoftness),

                tostring(tParsed.ShadowEnabled),
                tostring(tParsed.ShadowX),
                tostring(tParsed.ShadowY),
                tostring(tParsed.ShadowColor),

                tostring(tParsed.D3Enabled),
                tostring(tParsed.D3Depth),
                tostring(tParsed.D3StepX),
                tostring(tParsed.D3StepY),
                tostring(tParsed.D3Color),

                tostring(tParsed.GlowEnabled),
                tostring(tParsed.GlowGradientEnabled),
                tostring(tParsed.GlowColor),
                tostring(tParsed.GlowOuterColor),
                tostring(tParsed.GlowRadius),
                tostring(tParsed.GlowAlphaMax),

                tostring(tParsed.OutlineEnabled),
                tostring(tParsed.OutlineThickness),
                tostring(tParsed.OutlineColor),
            }, "\31");

            return sRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.ResolveColor
        @pulsarlua function FontStyle.ResolveColor
        @desc Resolves fixed RGB/RGBA or hex text, or a case-sensitive dotted CFG path containing identifier segments only. No code or expressions are evaluated. CFG is read from the current UserEnv on each call. References may resolve to native colors, packed RGBA integers, or fixed color strings. A syntactically valid but missing/invalid reference returns nil plus its path; callers can display black until configuration becomes available. INI inheritance must be resolved before this method is called.
        @param string sValue Fixed color text or a path such as CFG.Color.Tint.Air.
        @ret number|nil nColor Packed RGBA color, or nil when unresolved/invalid.
        @ret string|nil sPath Valid CFG path, or nil for fixed colors and invalid syntax.
        !]]
        public static ResolveColor(sValue)
        {
            local sText = rawtype(sValue) == "string" and sValue:match("^%s*(.-)%s*$") or "";
            local tParts = {};
            local vColor;

            if (sText:sub(1, 4) ~= "CFG.") then
                return FontStyle._tColor.TryFromString(sText), nil;
            end

            for sPart in sText:gmatch("[^%.]+") do
                if (not sPart:match("^[%a_][%w_]*$")) then return nil, nil; end
                tParts[#tParts + 1] = sPart;
            end
            if (#tParts < 2 or table.concat(tParts, ".") ~= sText) then return nil, nil; end

            --Styles can load before game configuration; unresolved paths are retained for later draws.
            if (UserEnv and rawtype(UserEnv.Get) == "function") then
                vColor = UserEnv.Get().CFG;
            end
            for nIndex = 2, #tParts do
                if (rawtype(vColor) ~= "table") then return nil, sText; end
                vColor = vColor[tParts[nIndex]];
            end

            if (rawtype(vColor) == "number" and vColor >= 0 and vColor <= 0xFFFFFFFF and vColor % 1 == 0) then
                return vColor, sText;
            elseif (rawtype(vColor) == "string") then
                return FontStyle._tColor.TryFromString(vColor), sText;
            elseif (wxlua.type(vColor) == "wxColour" and vColor:IsOk()) then
                return FontStyle._tColor.RGBA(vColor:Red(), vColor:Green(), vColor:Blue(), vColor:Alpha()), sText;
            end

            return nil, sText;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.ParseFontStyleINI
        @desc Parses a named style and its inherited values through the supplied or default INI reader.
        @param any sSectionName Section name.
        @param any oReader Reader.
        @vis private
        !]]
        private static ParseFontStyleINI(sSectionName, oReader)
        {
            local oSource = oReader or FontStyle._tState.INI;
            local tRet = nil;
            local tValueNames = nil;

            if (oSource and FontStyle.isstring(sSectionName) and not sSectionName:isempty()) then
                sSectionName = FontStyle.isstring(sSectionName) and sSectionName:upper() or "";
                tValueNames = oSource.GetValueNames(sSectionName);

                if (FontStyle.istable(tValueNames) and #tValueNames > 0) then

                    --[[!
                    @fqxn CFS.Classes.FontStyle.Private.Functions.val
                    @desc Resolves a value from the current inherited style section.
                    @param any sValName Val name.
                    @vis private
                    !]]
                    local function val(sValName)
                        local sRet = "";
                        local sVal = oSource.GetValue(sSectionName, sValName, true);

                        if (FontStyle.isstring(sVal)) then
                            sRet = sVal;
                        end

                        return sRet;
                    end

                    local sFontFamilyRaw    = val("Family");
                    local sFontFamily       = FontStyle.isstring(sFontFamilyRaw) and sFontFamilyRaw:trimright() or "";
                    local nFontSize         = FontStyle.floor(tonumber(val("Size")) or 12);
                    local nFontColor, sFontColorPath = FontStyle.ResolveColor(val("Color"));
                    nFontColor = nFontColor or FontStyle._oBlack;

                    local tFontOptions = {
                        Bold        = toboolean(val("Bold"))      and true or false,
                        Italic      = toboolean(val("Italic"))    and true or false,
                        Underline   = toboolean(val("Underline")) and true or false,
                        StrikeOut   = toboolean(val("StrikeOut")) and true or false,
                        HQ          = toboolean(val("HQ"))        and true or false,
                    };

                    local nShadowX          = tonumber(val("ShadowX"));
                    local nShadowY          = tonumber(val("ShadowY"));
                    local nShadowColor      = FontStyle._tColor.TryFromString(val("ShadowColor"), true) or FontStyle._oClear;
                    local bShadowEnabled    = toboolean(val("ShadowEnabled")) and true or false;

                    local nD3Color          = FontStyle._tColor.TryFromString(val("3DColor"), true) or FontStyle._oClear;
                    local nD3Depth          = tonumber(val("3DDepth"));
                    local nD3StepX          = tonumber(val("3DStepX"));
                    local nD3StepY          = tonumber(val("3DStepY"));
                    local b3DEnabled        = toboolean(val("3DEnabled")) and true or false;

                    local nGlowColor            = FontStyle._tColor.TryFromString(val("GlowColor"), true) or FontStyle._oClear;
                    local nGlowOuterColor       = FontStyle._tColor.TryFromString(val("GlowOuterColor"), true) or FontStyle._oClear;
                    local nGlowRadius           = tonumber(val("GlowRadius"));
                    local nGlowAlphaMax         = tonumber(val("GlowAlphaMax"));
                    local bGlowEnabled          = toboolean(val("GlowEnabled")) and true or false;
                    local bGlowGradientEnabled  = false;

                    local nOutlineThickness  = tonumber(val("OutlineThickness"));
                    local nOutlineColor      = FontStyle._tColor.TryFromString(val("OutlineColor"), true) or FontStyle._oClear;
                    local bOutlineEnabled    = toboolean(val("OutlineEnabled")) and true or false;

                    sFontFamily = not (sFontFamily:isempty()) and sFontFamily or "Times New Roman";
                    bGlowEnabled = FontStyle.isnumber(nGlowRadius) and FontStyle.isnumber(nGlowAlphaMax) and bGlowEnabled;
                    bGlowGradientEnabled = bGlowEnabled and nGlowOuterColor ~= FontStyle._oClear;

                    tRet = {
                        Name                = sSectionName,

                        FontFamily          = sFontFamily,
                        FontSize            = nFontSize,
                        FontColor           = nFontColor,
                        FontColorPath       = sFontColorPath,
                        GradientEnabled     = toboolean(val("GradientEnabled")) and true or false,
                        GradientStopsText   = val("GradientStops") ~= "" and val("GradientStops") or "0:#EAF6FF; 0.45:#95BBD0; 0.5:#D7EEFA; 1:#52778E",
                        GradientDirection   = val("GradientDirection") ~= "" and val("GradientDirection") or "Vertical",
                        WearPattern				= val("WearPattern"),
                        WearChipSizeMin			= val("WearChipSizeMin"),
                        WearChipSizeMax			= val("WearChipSizeMax"),
                        WearChipRoughness		= val("WearChipRoughness"),
                        WearEnabled				= toboolean(val("WearEnabled")) and true or false,
                        WearDensity				= val("WearDensity"),
                        WearLengthMin			= val("WearLengthMin"),
                        WearLengthMax			= val("WearLengthMax"),
                        WearWidth				= val("WearWidth"),
                        WearAngle				= val("WearAngle"),
                        WearAngleSpread			= val("WearAngleSpread"),
                        WearOpacity				= val("WearOpacity"),
                        WearColor				= FontStyle._tColor.TryFromString(val("WearColor"), true) or 0x302A20FF,
                        WearHighlightEnabled	= val("WearHighlightEnabled") == "" or toboolean(val("WearHighlightEnabled")) and true or false,
                        WearHighlightColor		= FontStyle._tColor.TryFromString(val("WearHighlightColor"), true) or 0xFFF4CBFF,
                        WearHighlightOffset		= val("WearHighlightOffset"),
                        WearSeed				= val("WearSeed"),
                        BevelEnabled			= val("BevelEnabled"),
                        BevelMode				= val("BevelMode"),
                        BevelProfile			= val("BevelProfile"),
                        BevelWidth				= val("BevelWidth"),
                        BevelDepth				= val("BevelDepth"),
                        BevelSoftness			= val("BevelSoftness"),
                        BevelEdgeTop			= val("BevelEdgeTop"),
                        BevelEdgeBottom			= val("BevelEdgeBottom"),
                        BevelEdgeLeft			= val("BevelEdgeLeft"),
                        BevelEdgeRight			= val("BevelEdgeRight"),
                        BevelLightAngle			= val("BevelLightAngle"),
                        BevelLightElevation		= val("BevelLightElevation"),
                        BevelHighlightColor		= val("BevelHighlightColor"),
                        BevelShadowColor		= val("BevelShadowColor"),
                        BevelHighlightStrength	= val("BevelHighlightStrength"),
                        BevelShadowStrength		= val("BevelShadowStrength"),
                        BevelSpecularStrength	= val("BevelSpecularStrength"),
                        BevelSpecularPower		= val("BevelSpecularPower"),
                        BevelOpacity			= val("BevelOpacity"),
                        FontOptions         = tFontOptions,
                        LetterSpacing       = tonumber(val("LetterSpacing")) or 0,
                        BackgroundEnabled   = toboolean(val("BackgroundEnabled")) and true or false,
                        BackgroundColor     = FontStyle._tColor.TryFromString(val("BackgroundColor"), true) or FontStyle._oClear,
                        BackgroundPadding   = math.max(0, tonumber(val("BackgroundPadding")) or 0),
                        ShadowRadius        = math.max(0, tonumber(val("ShadowRadius")) or 2),
                        ShadowSoftness      = val("ShadowRadius") ~= "",

                        ShadowEnabled       = FontStyle.isnumber(nShadowX) and FontStyle.isnumber(nShadowY) and bShadowEnabled,
                        ShadowX             = FontStyle.floor(nShadowX or 0),
                        ShadowY             = FontStyle.floor(nShadowY or 0),
                        ShadowColor         = nShadowColor,

                        D3Enabled           = FontStyle.isnumber(nD3Depth) and FontStyle.isnumber(nD3StepX) and FontStyle.isnumber(nD3StepY) and b3DEnabled,
                        D3Color             = nD3Color,
                        D3Depth             = FontStyle.floor(nD3Depth or 0),
                        D3StepX             = FontStyle.floor(nD3StepX or 0),
                        D3StepY             = FontStyle.floor(nD3StepY or 0),

                        GlowEnabled         = bGlowEnabled,
                        GlowGradientEnabled = bGlowGradientEnabled,
                        GlowColor           = nGlowColor,
                        GlowOuterColor      = nGlowOuterColor,
                        GlowRadius          = FontStyle.floor(nGlowRadius or 0),
                        GlowAlphaMax        = FontStyle.floor(nGlowAlphaMax or 0),

                        OutlineEnabled      = FontStyle.isnumber(nOutlineThickness) and bOutlineEnabled,
                        OutlineThickness    = FontStyle.floor(nOutlineThickness or 0),
                        OutlineColor        = nOutlineColor,
                    };
                end

            end

            return tRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Private.Functions.SyncStyles
        @desc Synchronizes cached styles and parsed settings with the active style file.
        @vis private
        !]]
        private static SyncStyles()
        {
            local tSectionNames     = {};
            local tSeen             = {};
            local sName             = "";
            local tParsed           = nil;
            local sFontSig          = "";
            local sEffectSig        = "";
            local tMeta             = nil;
            local oStyle            = nil;
            local bFontChanged      = false;
            local bEffectChanged    = false;

            if (FontStyle._tState.INI) then
                tSectionNames = FontStyle._tState.INI.GetSectionNames();

                for _, sName in ipairs(tSectionNames) do
                    sName = sName:upper();
                    tSeen[sName] = true;
                    tParsed = FontStyle.ParseFontStyleINI(sName);

                    if (FontStyle.istable(tParsed)) then
                        sFontSig   = FontStyle.BuildFontSignature(tParsed);
                        sEffectSig = FontStyle.BuildEffectSignature(tParsed);
                        tMeta      = FontStyle._tStyleMeta[sName];
                        oStyle     = FontStyle._tStyles[sName];

                        if not (oStyle) then
                            FontStyle._tStyles[sName] = FontStyle(sName, tParsed);
                            FontStyle._tStyleMeta[sName] = {
                                FontSig   = sFontSig,
                                EffectSig = sEffectSig,
                            };
                            FontStyle._tParsedStyles[sName] = tParsed;
                        else
                            bFontChanged   = not (tMeta) or tMeta.FontSig ~= sFontSig;
                            bEffectChanged = not (tMeta) or tMeta.EffectSig ~= sEffectSig;

                            if (bFontChanged or bEffectChanged) then
                                oStyle.ApplyParsed(tParsed, bFontChanged);
                                FontStyle._tStyleMeta[sName] = {
                                    FontSig   = sFontSig,
                                    EffectSig = sEffectSig,
                                };
                                FontStyle._tParsedStyles[sName] = tParsed;
                            end

                        end

                    end

                end

                for sName in pairs(FontStyle._tStyles) do

                    if not (tSeen[sName]) then
                        FontStyle._tStyles[sName] = nil;
                        FontStyle._tStyleMeta[sName] = nil;
                        FontStyle._tParsedStyles[sName] = nil;
                    end

                end

            end
        }

        static FontStyle()
        {
            --create the STYLE constant
            local tStyleProxy = {};
            local tStyleProxyMeta = {
                __index = function(t, k)
                    local sName = rawtype(k) == "string" and k or "";
                    return not (sName:isempty()) and FontStyle._tStyles[sName:upper()] or nil;
                end,

                __newindex = function(t, k, v)
                    error("Styles is read-only.", 2);
                end,

                __metatable = "locked",
            };

            local tStyle = setmetatable(tStyleProxy, tStyleProxyMeta);
            constant("STYLE", tStyle);
        }

        --METAMETHODS
        public operator ()(sText)
        {
            --TODO assertions
            local sName = this.Name;
            return '<'..sName..'>'..sText..'</'..sName..'>'
        }

        --[[Reload = function()
                    LoadAndSync();
                end,]]


                --[[!
                @fqxn CFS.Classes.FontStyle.Methods.Parse
                @pulsarlua function FontStyle.Parse
                @desc Returns parsed settings for a named style through the supplied or default INI reader.
                @param any sName Name.
                @param any oReader Reader.
                !]]
        public static Parse(sName, oReader)
        {
            return FontStyle.ParseFontStyleINI(sName, oReader);
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.Get
        @pulsarlua function FontStyle.Get
        @desc Gets a font style object by name.
        @param string sName The name of the font style to retrieve.
        @return FontStyle|nil oFontStyle The matching FontStyle object, or nil if not found.
        !]]
        public static Get(sName)
        {
            local oRet;

            if (FontStyle.isstring(sName) and not sName:isempty()) then
                oRet = FontStyle._tStyles[sName:upper()];
            end

            return oRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.Has
        @pulsarlua function FontStyle.Has
        @desc Checks if a font style exists.
        @param string sName The name of the font style.
        @return boolean bHas True if the style exists; otherwise false.
        !]]
        public static Has(sName)
        {
            local bRet = false;

            if (FontStyle.isstring(sName) and not sName:isempty()) then
                bRet = FontStyle._tStyles[sName:upper()] and true or false;
            end

            return bRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.GetNames
        @pulsarlua function FontStyle.GetNames
        @desc Gets all registered font style names.
        @return table tNames A sorted array of font style names.
        !]]
        public static GetNames()
        {
            local tRet = {};
            local sName = "";

            for sName in pairs(FontStyle._tStyles) do
                table.insert(tRet, sName);
            end

            table.sort(tRet);

            return tRet;
        }

        --[[!
        @fqxn CFS.Classes.FontStyle.Methods.UpdateINI
        @pulsarlua function FontStyle.UpdateINI
        @desc Loads and synchronizes font styles from an INI file.
        @param string sINI The path to the INI file.
        @param boolean bCaseSensitive Optional; defaults to true. False enables case-insensitive INI section/key lookup.
        !]]
        public static UpdateINI(sINI, bCaseSensitive)
        {
            if (rawtype(sINI) == "string") then
                FontStyle._tState.INI = FontStyle.Ini(sINI, bCaseSensitive);
                FontStyle.SyncStyles();
            end
        }

