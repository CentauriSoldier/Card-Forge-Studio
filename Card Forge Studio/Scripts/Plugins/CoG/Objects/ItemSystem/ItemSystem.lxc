--[[!
    @fqxn CoG.ItemSystem
    @desc An ordered inventory of individual CoGItem instances. Capacity defaults to math.huge, membership is empty, enabled is true and locked is false. Storage eligibility, exclusivity and ancestor restrictions are enforced by shared transactions. Owners are external references and must be reconnected after loading.
!]]
namespace CoG {
    class ItemSystem {
        private static _tRules = require("cog.Objects.ItemSystem.ItemRules");
        private state = {};

        --[[!
        @fqxn CoG.ItemSystem.Methods.__len
        @desc Returns the collection count used by the length operator; see the delegated count method.
        !]]
        public operator __len() {
            return this.getItemCount();
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.__pairs
        @desc Iterates a copied membership list through the collection's public iterator.
        !]]
        public operator __pairs() {
            return this.eachItem();
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.__clone
        @desc Requires callers to choose how concrete items are cloned before populating another container.
        !]]
        public operator clone() {
            error("Clone concrete items explicitly, then insert them into a new ItemSystem.");
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.validateSnapshot
        @desc Checks saved fields during native graph restoration.
        !]]
        private validateSnapshot(tState) {
            ItemSystem._tRules.validateSnapshot(tState.pri.state, "inventory");
            this.restoreRuntime();
            ItemSystem._tRules.validateRestored(this);
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.prepareSnapshot
        @desc Prepares a copied class snapshot without changing the live inventory.
        !]]
        private prepareSnapshot(tState) {
            -- Native projections are shallow; copy the state record before omitting links.
            local tCopy = {};
            for k, v in pairs(tState.pri.state) do tCopy[k] = v; end
            ItemSystem._tRules.prepareSnapshot(tCopy);
            tState.pri.state = tCopy;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.restoreRuntime
        @desc Internal reconnection after native deserialization; retains saved
        membership and restores runtime lookups without permission callbacks.
        !]]
        public final restoreRuntime(tToken) {
            ItemSystem._tRules.restore(this, this.state, tToken);
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.ItemSystem
        @desc Creates an inventory with optional capacity, initial items and an external owner. Initial
        membership is validated as one transaction.
        !]]
        public ItemSystem(nMaxItems, tItems, oOwner) {
            nMaxItems = nMaxItems == nil and math.huge or nMaxItems;
            ItemSystem._tRules.integer(nMaxItems, 0, true);
            this.state = ItemSystem._tRules.create(this, "inventory", nMaxItems, oOwner);

            -- Initial membership enters through the same whole-hierarchy validation as later edits.
            if (tItems ~= nil) then
                local tInput = ItemSystem._tRules.array(tItems);
                local bOK, sReason = ItemSystem._tRules.transaction({this}, function()

                    for _, oItem in ipairs(tInput) do
                        ItemSystem._tRules.item(oItem);
                        assert(oItem.getLocation() == null, "Initial item already has a location.");
                    end

                    -- Publish projected membership; the transaction commits item locations after validation.
                    ItemSystem._tRules.state(this).items = tInput;
                end);

                assert(bOK, sReason);
            end
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.setOwner
        @desc Reconnects the caller-owned owner after loading. The owner is not saved.
        @param object|null oOwner A class instance, or null to clear the owner.
        @ret ItemSystem this This container.
        !]]
        public setOwner(oOwner) {
            ItemSystem._tRules.setOwner(this, oOwner);

            return this;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.getOwner
        @desc Resolves the owner through the container hierarchy; an outer owner takes precedence.
        !]]
        public getOwner() {
            return ItemSystem._tRules.owner(this);
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.getItemStashSystem
        @desc Returns the containing stash, or null when this inventory is independent.
        !]]
        public getItemStashSystem() {
            return ItemSystem._tRules.state(this).parent or null;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.getMaxItems
        @desc Returns the item capacity; math.huge represents an unlimited inventory.
        !]]
        public getMaxItems() {
            return ItemSystem._tRules.state(this).capacity;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.setMaxItems
        @desc Validates the proposed capacity and commits it only if all current items still fit.
        !]]
        public setMaxItems(nCapacity) {
            ItemSystem._tRules.integer(nCapacity, 0, true);

            local bOK, sReason = ItemSystem._tRules.transaction({this}, function()
                ItemSystem._tRules.state(this).capacity = nCapacity;
            end);

            return this, bOK, nil, sReason;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.isEnabled
        @desc Returns this container's own enabled flag; mutations also check its ancestors.
        !]]
        public isEnabled() {
            return ItemSystem._tRules.state(this).enabled;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.isLocked
        @desc Returns this container's own lock flag; mutations also check its ancestors.
        !]]
        public isLocked() {
            return ItemSystem._tRules.state(this).locked;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.setEnabled
        @desc Sets the local enabled flag and returns this container. Ancestor restrictions still apply.
        !]]
        public setEnabled(bValue) {
            ItemSystem._tRules.setFlag(this, "enabled", bValue);

            return this;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.setLocked
        @desc Sets the local lock flag and returns this container. Locked ancestors still prevent edits.
        !]]
        public setLocked(bValue) {
            ItemSystem._tRules.setFlag(this, "locked", bValue);

            return this;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.addItem
        @desc Adds an unlocated item through the shared transaction rules; returns this, success, nil and an optional reason.
        !]]
        public addItem(oItem) {
            local bOK, sReason = ItemSystem._tRules.add(this, oItem);

            return this, bOK, nil, sReason;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.removeItem
        @desc Removes the first item, a specified index or an exact item instance; an optional actor must have
        removal permission.
        !]]
        public removeItem(vItem, oActor) {
            local bOK, vResult = ItemSystem._tRules.remove(this, vItem, oActor);

            return this, bOK, bOK and vResult or nil, not bOK and vResult or nil;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.clear
        @desc Removes items throughout this subtree in one transaction; returns this, success, removed items or
        a failure reason.
        !]]
        public clear() {
            local bOK, vResult = ItemSystem._tRules.clear(this);

            return this, bOK, bOK and vResult or nil, not bOK and vResult or nil;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.containsItem
        @desc Looks for the exact item instance, returning its position when found and -1 when absent.
        !]]
        public containsItem(oItem) {
            ItemSystem._tRules.item(oItem);
            local nIndex = ItemSystem._tRules.indexOf(this, oItem);

            return nIndex ~= nil, nIndex or -1;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.containsItemAt
        @desc Checks exact item identity at the requested position rather than comparing item values.
        !]]
        public containsItemAt(oItem, nIndex) {
            ItemSystem._tRules.item(oItem);
            ItemSystem._tRules.integer(nIndex, 1);

            return rawequal(ItemSystem._tRules.state(this).items[nIndex], oItem);
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.getItemAt
        @desc Returns the item at a positive one-based index, or nil when that position is empty.
        !]]
        public getItemAt(nIndex) {
            ItemSystem._tRules.integer(nIndex, 1);

            return ItemSystem._tRules.state(this).items[nIndex];
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.getItemCount
        @desc Returns the number of items directly held by this inventory.
        !]]
        public getItemCount() {
            return #ItemSystem._tRules.state(this).items;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.eachItem
        @desc Iterates a copied list of item references, keeping callers away from the live membership array.
        !]]
        public eachItem() {
            return ipairs(ItemSystem._tRules.items(this));
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.iterator
        @desc Aliases eachItem so both entry points use the same copied membership list.
        !]]
        public iterator() {
            return this.eachItem();
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.swapItems
        @desc Swaps the selected contents inside a transaction so capacity, eligibility and hierarchy rules all
        apply.
        !]]
        public swapItems(nFirst, nSecond) {
            ItemSystem._tRules.integer(nFirst, 1);
            ItemSystem._tRules.integer(nSecond, 1);

            local bOK, sReason = ItemSystem._tRules.transaction({this}, function()
                ItemSystem._tRules.editable(this);

                -- Swap references in place; item locations stay in this same inventory.
                local tItems = ItemSystem._tRules.state(this).items;
                assert(nFirst ~= nSecond and tItems[nFirst] and tItems[nSecond], "Invalid swap indices.");
                tItems[nFirst], tItems[nSecond] = tItems[nSecond], tItems[nFirst];
            end);

            return this, bOK, nil, sReason;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.transferItemTo
        @desc Moves the exact item between leaf containers atomically; failures retain the original membership.
        !]]
        public transferItemTo(oDestination, oItem, bReplace) {
            local bOK, vResult = ItemSystem._tRules.transfer(this, oDestination, oItem, bReplace);

            return this, bOK, bOK and vResult or nil, not bOK and vResult or nil;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.consumeItem
        @desc Checks the actor's consumption permission and removes the item. Gameplay effects remain the
        caller's responsibility.
        !]]
        public consumeItem(oItem, oActor) {
            assert(oActor ~= nil, "Consumption requires an actor.");
            local bOK, vResult = ItemSystem._tRules.remove(this, oItem, oActor, "canConsumeBy");

            return this, bOK, bOK and vResult or nil, not bOK and vResult or nil;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.tradeItemTo
        @desc Checks both trading permissions before moving the item atomically; pricing and payment belong to
        the caller.
        !]]
        public tradeItemTo(oDestination, oItem, oTrader, oRecipient) {
            local bOK, vResult = ItemSystem._tRules.transfer(this, oDestination, oItem, false, function()
                return oItem.canTradeBy(oTrader) and oItem.canTradeTo(oRecipient);
            end);

            return this, bOK, bOK and vResult or nil, not bOK and vResult or nil;
        }

        --[[!
        @fqxn CoG.ItemSystem.Methods.validate
        @desc Previews validation of the current hierarchy and rolls back projected state; returns success and
        an optional reason.
        !]]
        public validate() {
            return ItemSystem._tRules.check(this);
        }

    }
}
