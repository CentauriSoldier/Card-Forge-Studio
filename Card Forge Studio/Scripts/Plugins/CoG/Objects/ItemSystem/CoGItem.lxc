        -- Validate supplied components before the parent constructor runs. The
        -- constructor then creates each omitted default exactly once.
        private static checkComponent(vInput, cExpected, sField) {
            assert(vInput == nil or class.isa(vInput, cExpected),
                "CoGItem "..sField.." must be an instance of "..class.getname(cExpected)..".");
        }

        private static checkInputs(sName, sDescription, eRarity, wEventrix, oAttachableTo, oConsumableBy, oDamageableBy, oDetachableBy, oEquippableBy, vExclusiveIn, oExclusiveWith, bInimitable, oRemovableBy, oRepairableBy, oStorableIn, oTradableBy, oTradableTo, oUnequippableBy, oUpgradeableBy, oDowngradableBy, oDurability, oSize, oValue, oWeight, oAttachedTo, oLocation, oSlotPattern) {
            for _, tField in ipairs({{"Attachable_To", oAttachableTo}, {"Consumable_By", oConsumableBy},
            {"Damageable_By", oDamageableBy}, {"Detachable_By", oDetachableBy},
            {"Equipable_By", oEquippableBy}, {"Removable_By", oRemovableBy},
            {"Repairable_By", oRepairableBy}, {"Tradable_By", oTradableBy},
            {"Tradable_To", oTradableTo}, {"Unequippable_By", oUnequippableBy},
            {"Upgradeable_By", oUpgradeableBy}, {"Downgradable_By", oDowngradableBy}}) do
                CoGItem.checkComponent(tField[2], CoG.CoGRegistry, tField[1]);
            end
            CoGItem.checkComponent(oExclusiveWith, LuaEx.Classes.ClassRegistry, "Exclusive_With");
            CoGItem.checkComponent(oStorableIn, LuaEx.Classes.ClassRegistry, "Storable_In");
            if (vExclusiveIn ~= nil and not (class.isa(vExclusiveIn, CoG.ItemSlotSystem)
                or class.isa(vExclusiveIn, CoG.ItemSystem) or class.isa(vExclusiveIn, CoG.ItemStashSystem))) then
                CoGItem.checkComponent(vExclusiveIn, LuaEx.Classes.ClassRegistry, "Exclusive_In");
            end
            CoGItem.checkComponent(oDurability, CoG.Pool, "Durability");
            CoGItem.checkComponent(oSize, CoG.Pool, "Size");
            CoGItem.checkComponent(oValue, CoG.Pool, "Value");
            CoGItem.checkComponent(oWeight, CoG.Pool, "Weight");
            assert(bInimitable == nil or rawtype(bInimitable) == "boolean", "Inimitable must be a boolean or nil.");
            assert(oAttachedTo == nil or oAttachedTo == null or class.isa(oAttachedTo, CoG.CoGBase), "Attached_To must be a CoG instance or null.");
            assert(oLocation == nil or oLocation == null or class.isinstance(oLocation), "Location must be a class instance or null.");
            CoGItem.checkComponent(oSlotPattern, CoG.SlotPattern, "Slot_Pattern");
            return sName;
        }
    }
}
