--[[!
    @fqxn CoG.CoGItem
    @desc Base class for individual items. CoGRegistry action permissions and ClassRegistry storage/conflict fields express eligibility;
    callers perform actions and enforce their gameplay consequences. Durability
    reaching zero does not imply destruction. Inimitable is metadata only.
    Every omitted registry/Pool/SlotPattern input creates a fresh object in the constructor;
    validated supplied objects are retained by reference. Stacking belongs to
    ItemSlot. Trading also covers selling; callers determine cost from Value.
!]]
namespace CoG {
    class CoGItem : CoG.CoGObject requires(CoG.CoGRegistry, CoG.Pool, CoG.SlotPattern, LuaEx.Classes.ClassRegistry) {
        private static _tRules = require("cog.Objects.ItemSystem.ItemRules");
        private static _tPersistence = require("cog.Objects.ItemSystem.ItemPersistence");
        private location = {};
        private attachment = {};
        private attachedItems = {};
        private identity = {};
        private persistenceID = 0;
        protected Attachable_To = null;
        protected Consumable_By = null;
        protected Damageable_By = null;
        protected Detachable_By = null;
        protected Equipable_By = null;
        protected Exclusive_In = null;
        protected Exclusive_With = null;
        protected Inimitable = false;
        public isInimitable() { return this.Inimitable; }
        protected Removable_By = null;
        protected Repairable_By = null;
        protected Storable_In = null;
        protected Tradable_By = null;
        protected Tradable_To = null;
        protected Unequippable_By = null;
        protected Upgradeable_By = null;
        protected Downgradable_By = null;
        protected Durability = null;
        protected Size = null;
        protected Value = null;
        protected Weight = null;
        protected Slot_Pattern = null;

        private static acceptObject(vInput, cExpected, defaultFactory, sField) {

            if (vInput == nil) then
                return defaultFactory();
            end

            assert(class.isa(vInput, cExpected),
                   "CoGItem "..sField.." must be an instance of "..class.getname(cExpected)..".");

            return vInput;
        }

        private static defaultCoGRegistry() {

            return CoG.CoGRegistry();
        }

        private static defaultRegistry() {

            return LuaEx.Classes.ClassRegistry();
        }

        private static defaultDurability() {

            return CoG.Pool(1, 1);
        }

        private static defaultQuantity() {

            return CoG.Pool(1, 0);
        }

        private static defaultSlotPattern() {

            return CoG.SlotPattern();
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.__clone
        @desc Requires callers to choose how concrete items are cloned before populating another container.
        !]]
        public operator clone() {

            --TODO Define copying of subclass state, attachments and CoGObject affixes.
            -- Inimitable is deliberately not enforced here.
            error("CoGItem subclasses must implement __clone for their item state.");
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.eachAttachmentOf
        @desc Validates a CoG host and iterates a copied list of its attached item references.
        !]]
        public static eachAttachmentOf(oHost) {
            assert(class.isinstance(oHost) and class.isa(oHost, CoG.CoGBase), "Attachment host must be a CoG instance.");

            return ipairs(CoGItem._tRules.attachments(oHost));
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.validateSnapshot
        @desc Validates saved identity and attachment/location holders during native graph restoration.
        !]]
        private validateSnapshot(tState) {
            CoGItem._tRules.integer(tState.pri.persistenceID, 1);
            type.assert.table(tState.pri.attachedItems);
            type.assert.table(tState.pri.location);
            type.assert.table(tState.pri.attachment);
            assert(type.isnull(tState.pri.location.value) or class.isinstance(tState.pri.location.value), "Invalid saved item location.");
            assert(type.isnull(tState.pri.attachment.host) or class.isa(tState.pri.attachment.host, CoG.CoGBase), "Invalid saved attachment host.");
            this.restoreItemRuntime();
            CoGItem._tRules.validateAttachment(this);
            CoGItem._tRules.validateAttachments(this);
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.prepareSnapshot
        @desc Registers the concrete item adapter, wraps permission registries and omits inverse links from the
        copied snapshot.
        !]]
        private prepareSnapshot(tState) {
            -- Native registries retain callbacks, shared identities and cycles directly.
            -- Replace projected records; never mutate the live holder tables.
            tState.pri.identity = {};
            tState.pri.location = {value = null};
            tState.pri.attachment = {host = null};
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.CoGItem
        @desc Protected constructor invoked by concrete item subclasses.
        Registry/Pool arguments are optional objects, never booleans or numbers.
        vExclusiveIn accepts a ClassRegistry or a particular supported system instance;
        omission includes slot systems, inventories and stashes. Other registries start empty.
        Location and Attached_To accept class instances or null/nil; omitted values
        remain null. Attached_To identifies one CoG host. Inimitable defaults false.
        !]]
        protected CoGItem(sName, sDescription, eRarity, wEventrix,
                        oAttachableTo, oConsumableBy, oDamageableBy, oDetachableBy,
                        oEquippableBy, vExclusiveIn, oExclusiveWith, bInimitable,
                        oRemovableBy, oRepairableBy, oStorableIn,
                        oTradableBy, oTradableTo, oUnequippableBy,
                        oUpgradeableBy, oDowngradableBy,
                        oDurability, oSize, oValue, oWeight,
                        oAttachedTo, oLocation, oSlotPattern) {
            base(CoG.CoGItem.checkInputs(sName, sDescription, eRarity, wEventrix, oAttachableTo, oConsumableBy, oDamageableBy, oDetachableBy, oEquippableBy, vExclusiveIn, oExclusiveWith, bInimitable, oRemovableBy, oRepairableBy, oStorableIn, oTradableBy, oTradableTo, oUnequippableBy, oUpgradeableBy, oDowngradableBy, oDurability, oSize, oValue, oWeight, oAttachedTo, oLocation, oSlotPattern), sDescription, eRarity, wEventrix);
            local pro = this;
            local tFields = {};

            -- Validate component inputs before publishing any of them as this item's fields.
            local tObjectRegistries = {
                {"Attachable_To", oAttachableTo}, {"Consumable_By", oConsumableBy},
                {"Damageable_By", oDamageableBy}, {"Detachable_By", oDetachableBy},
                {"Equipable_By", oEquippableBy}, {"Removable_By", oRemovableBy},
                {"Repairable_By", oRepairableBy}, {"Tradable_By", oTradableBy},
                {"Tradable_To", oTradableTo}, {"Unequippable_By", oUnequippableBy},
                {"Upgradeable_By", oUpgradeableBy}, {"Downgradable_By", oDowngradableBy},
            };

            for _, tField in ipairs(tObjectRegistries) do
                tFields[tField[1]] = CoGItem.acceptObject(tField[2], CoG.CoGRegistry, CoGItem.defaultCoGRegistry, tField[1]);
            end

            tFields.Exclusive_With = CoGItem.acceptObject(oExclusiveWith, LuaEx.Classes.ClassRegistry, CoGItem.defaultRegistry, "Exclusive_With");
            tFields.Storable_In = CoGItem.acceptObject(oStorableIn, LuaEx.Classes.ClassRegistry, CoGItem.defaultRegistry, "Storable_In");

            -- Default scopes match container classes. A supplied system instance narrows scope by identity.
            if (vExclusiveIn == nil) then
                tFields.Exclusive_In = LuaEx.Classes.ClassRegistry({CoG.ItemSlotSystem, CoG.ItemSystem, CoG.ItemStashSystem});
            elseif (class.isinstance(vExclusiveIn) and
                    (class.isa(vExclusiveIn, CoG.ItemSlotSystem) or
                     class.isa(vExclusiveIn, CoG.ItemSystem) or
                     class.isa(vExclusiveIn, CoG.ItemStashSystem))) then
                tFields.Exclusive_In = LuaEx.Classes.ClassRegistry({vExclusiveIn});
            else
                tFields.Exclusive_In = CoGItem.acceptObject(vExclusiveIn, LuaEx.Classes.ClassRegistry, CoGItem.defaultRegistry, "Exclusive_In");
            end

            tFields.Durability = CoGItem.acceptObject(oDurability, CoG.Pool, CoGItem.defaultDurability, "Durability");
            tFields.Size = CoGItem.acceptObject(oSize, CoG.Pool, CoGItem.defaultQuantity, "Size");
            tFields.Value = CoGItem.acceptObject(oValue, CoG.Pool, CoGItem.defaultQuantity, "Value");
            tFields.Weight = CoGItem.acceptObject(oWeight, CoG.Pool, CoGItem.defaultQuantity, "Weight");
            assert(bInimitable == nil or rawtype(bInimitable) == "boolean", "Inimitable must be a boolean or nil.");

            if (oAttachedTo ~= nil and oAttachedTo ~= null) then
                assert(class.isinstance(oAttachedTo) and class.isa(oAttachedTo, CoG.CoGBase),
                       "Attached_To must be a CoG instance or null.");
            end

            if (oLocation ~= nil and oLocation ~= null) then
                assert(class.isinstance(oLocation), "Location must be a class instance or null.");
            end

            tFields.Slot_Pattern = CoGItem.acceptObject(oSlotPattern, CoG.SlotPattern, CoGItem.defaultSlotPattern, "Slot_Pattern");

            -- Parent construction is complete; publish the validated item fields together.
            for sField, oObject in pairs(tFields) do
                pro[sField] = oObject;
            end

            -- Hold inverse references inside tables so changing targets preserves each declared field type.
            pro.Inimitable = bInimitable == true;
            this.attachment.host = oAttachedTo or null;
            this.location.value = oLocation or null;
            this.persistenceID = CoGItem._tPersistence.identify(this);
            this.identity.object = this;
            CoGItem._tRules.registerHost(this, this.attachedItems);
            CoGItem._tRules.registerAttachment(this, this.attachment);
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.restoreItemRuntime
        @desc Internal save/load reconnection of location and attachment indexes.
        Membership restores exact decoded identities without permission callbacks.
        !]]
        public final restoreItemRuntime(tToken) {

            -- Optional tokens isolate explicit runtime reconnection sessions.
            if (tToken) then
                CoGItem._tPersistence.reconnect(this.persistenceID, this, tToken);
            end

            this.persistenceID = CoGItem._tPersistence.identify(this);
            this.identity.object = this;
            CoGItem._tRules.registerHost(this, this.attachedItems, tToken);
            CoGItem._tRules.registerAttachment(this, this.attachment);

            -- Repeated reconnection must not insert this item into the same location twice.
            local oLocation = this.location.value;

            if (oLocation ~= null) then
                oLocation.restoreRuntime();
                local tState = CoGItem._tRules.state(oLocation);

                if (not CoGItem._tRules.indexOf(oLocation, this)) then
                    tState.items[#tState.items + 1] = this;
                end
            end
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.getAttached_To
        @desc Returns this item's attachment host, or null when detached.
        !]]
        public final getAttached_To() {
            return this.attachment.host;
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.eachAttachment
        @desc Iterates a copied list of items attached to this item.
        !]]
        public eachAttachment() {
            return ipairs(CoGItem._tRules.attachments(this));
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.attachTo
        @desc Checks attachment permission and cycle rules before connecting this item to the host.
        !]]
        public attachTo(oHost) {
            local bOK, sReason = CoGItem._tRules.attach(this, oHost);

            return this, bOK, sReason;
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.detach
        @desc Checks the actor's detach permission before removing this item from its current host.
        !]]
        public detach(oActor) {
            local bOK, sReason = CoGItem._tRules.detach(this, oActor);

            return this, bOK, sReason;
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.getLocation
        @desc Returns the current leaf container, or null while the item is not stored.
        !]]
        public final getLocation() {
            return this.location.value;
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.setLocation
        @desc Changes the location only when the expected previous identity matches; transactions control writes
        during callbacks.
        !]]
        public final setLocation(oLocation, oExpectedLocation) {
            assert(CoGItem._tRules.canWriteLocation(), "Location mutations are forbidden inside prerequisite callbacks.");
            assert(oLocation == null or class.isinstance(oLocation), "Location must be a class instance or null.");

            -- Refuse to overwrite a location whose exact identity changed since the operation began.
            assert(rawequal(this.location.value, oExpectedLocation), "Item location changed; transfer rejected.");
            this.location.value = oLocation;

            return this;
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.getAttachableToRegistry
        @desc Returns the Attachable_To component by reference without a replacement setter.
        !]]
        public getAttachableToRegistry() {
            return this.Attachable_To;
        }

