        --[[!
        @fqxn CoG.CoGItem.Methods.canAttachTo
        @desc Checks Attachable_To with the actor/host, this item and additional arguments.
            Returns the permission boolean and optional reason.
        !]]
        public canAttachTo(oObject, ...) {
            return this.Attachable_To.allows(oObject, this, ...);
        }

        --[[!
        @fqxn CoG.CoGItem.Methods.canConsumeBy
        @desc Checks Consumable_By with the actor/host, this item and additional arguments.
            Returns the permission boolean and optional reason.
        !]]
        public canConsumeBy(oObject, ...) {
            return this.Consumable_By.allows(oObject, this, ...);
        }

        --[[!
