--[[!
@fqxn CoG.CoGVehicle
@pulsarlua class CoGVehicle
@desc Generic vehicle metadata, fuel and configured component slots. Supplied Pools,
    components and owners retain identity; omitted defaults are per-instance.
    Flags describe application policy and do not implement travel, trade or quests.
    Concrete subclasses define their own copying policy through the clone operator.
!]]
namespace CoG {
    class CoGVehicle : CoGObject {
        --[[!
        @fqxn CoG.CoGVehicle.COMPONENT
        @desc Canonical component slots declared before classes initialize.
            Extend this declaration to add slots; configuration supplies settings.
        !]]
        public enum COMPONENT within CoG.CoGVehicle { BODY; }
        protected Components = {};
        protected DistancePerFuelUnit = 0;
        protected Exclusive = false;
        protected Fuel = null;
        protected Inimitable = false;
        protected MaxSpeed = 0;
        protected Owner = null;
        protected Quest = false;
        protected Tradeable = true;
        protected Unmanned = false;
        protected Value = 0;

        --[[!
        @fqxn CoG.CoGVehicle.Helpers.componentName
        @desc Resolves an exact configured slot name or an owned component enum member.
        !]]
        private static componentName(vComponent) {
            local sName;
            local eComponents = CoGVehicle.COMPONENT;

            if (lxe.isMember(vComponent, eComponents)) then
                sName = vComponent.Name;
            elseif (rawtype(vComponent) == "string") then

                for _, eComponent in eComponents() do

                    if (vComponent == eComponent.Name) then
                        sName = vComponent;
                        break;
                    end

                end

            end

            assert(sName ~= nil, "Unknown CoGVehicle component slot.");

            return sName;
        }

        --[[!
        @fqxn CoG.CoGVehicle.Helpers.validateComponent
        @desc Requires a class instance or null for an empty slot.
        !]]
        private static validateComponent(oComponent) {
            assert(type.isnull(oComponent) or class.isinstance(oComponent),
                   "Vehicle components must be class instances or null.");
        }

        --[[!
        @fqxn CoG.CoGVehicle.Helpers.buildComponents
        @desc Allocates independent slot bindings and validates the complete initializer.
        !]]
        private static buildComponents(tComponents) {
            assert(tComponents == nil or type(tComponents) == "table", "Vehicle components must be a table or nil.");

            local tSlots = {};
            local tSeen = {};
            local eComponents = CoGVehicle.COMPONENT;

            for _, eComponent in CoGVehicle.COMPONENT() do
                tSlots[eComponent.Name] = null;
            end

            for vComponent, oComponent in pairs(tComponents or {}) do
                local sName = CoGVehicle.componentName(vComponent);

                assert(not tSeen[sName], "Vehicle component slot supplied more than once: "..sName);
                CoGVehicle.validateComponent(oComponent);

                tSeen[sName] = true;
                tSlots[sName] = oComponent;
            end

            return tSlots;
        }

        --[[!
        @fqxn CoG.CoGVehicle.Helpers.validateNumber
        @desc Requires a finite nonnegative measurement or vehicle value.
        !]]
        private static validateNumber(nValue, sName) {
            assert(rawtype(nValue) == "number" and nValue >= 0 and nValue < math.huge,
                   "CoGVehicle "..sName.." must be a finite nonnegative number.");
        }

        --[[!
        @fqxn CoG.CoGVehicle.Helpers.booleanValue
        @desc Defaults only nil flags, preserving explicit false and rejecting other types.
        !]]
        private static booleanValue(bValue, bDefault, sName) {
            assert(bValue == nil or rawtype(bValue) == "boolean", "CoGVehicle "..sName.." must be a boolean or nil.");

            if (bValue == nil) then
                return bDefault;
            end

            return bValue;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.CoGVehicle
            @desc Initializes CoGObject, validates vehicle inputs, then stores the
            vehicle state. Owner and inherited metadata are optional trailing arguments.
            Only nil selects defaults. Fuel defaults to Pool(); numbers to zero;
            Tradable to true; other flags to false. Tradable covers selling as well
            as other trades. Component slots are case-sensitive.
            @param Pool|nil oFuel Fuel Pool or subclass instance, retained by reference.
            @param boolean|nil bUnmanned Whether the vehicle is unmanned.
            @param number|nil nDistancePerFuelUnit Finite nonnegative fuel efficiency.
            @param table|nil tComponents Configured names or enum members mapped to objects.
            @param number|nil nValue Finite nonnegative vehicle value.
            @param boolean|nil bTradable Whether the vehicle can be traded, including sold.
            @param boolean|nil bQuest Whether the vehicle is quest-related.
            @param boolean|nil bExclusive Whether the vehicle is exclusive.
            @param boolean|nil bInimitable Caller-enforced copying metadata.
            @param number|nil nMaxSpeed Finite nonnegative maximum speed.
            @param object|null|nil oOwner Optional class instance; nil means null.
            @param string|nil sName Nonblank name, defaulting to Vehicle.
            @param string|nil sDescription Nonblank description, defaulting to A vehicle.
            @param CoG.LEVEL|nil eRarity Rarity passed to CoGObject.
            @param string|nil sEventrixEnvironment Event environment name passed to CoGObject.
            @throws Invalid vehicle inputs or an inherited constructor error.
        !]]
        public CoGVehicle(oFuel, bUnmanned, nDistancePerFuelUnit,
            tComponents, nValue, bTradable, bQuest, bExclusive, bInimitable,
            nMaxSpeed, oOwner, sName, sDescription, eRarity, sEventrixEnvironment) {
            base(sName == nil and "Vehicle" or sName,
                sDescription == nil and "A vehicle." or sDescription,
                eRarity, sEventrixEnvironment);
            -- Validate vehicle state before storing any vehicle-specific fields.
            if (oFuel ~= nil) then
                assert(class.isa(oFuel, Pool),
                       "CoGVehicle Fuel must be a Pool instance.");
            end

            nDistancePerFuelUnit    = nDistancePerFuelUnit == nil and 0 or nDistancePerFuelUnit;
            nValue                  = nValue == nil and 0 or nValue;
            nMaxSpeed               = nMaxSpeed == nil and 0 or nMaxSpeed;

            CoGVehicle.validateNumber(nDistancePerFuelUnit,    "DistancePerFuelUnit");
            CoGVehicle.validateNumber(nValue,                  "Value");
            CoGVehicle.validateNumber(nMaxSpeed,               "MaxSpeed");

            bUnmanned   = CoGVehicle.booleanValue(bUnmanned,   false,  "Unmanned");
            bTradable  = CoGVehicle.booleanValue(bTradable,  true,   "Tradable");
            bQuest      = CoGVehicle.booleanValue(bQuest,      false,  "Quest");
            bExclusive  = CoGVehicle.booleanValue(bExclusive,  false,  "Exclusive");
            bInimitable = CoGVehicle.booleanValue(bInimitable, false,  "Inimitable");

            local tSlots = CoGVehicle.buildComponents(tComponents);

            assert(oOwner == nil or type.isnull(oOwner) or class.isinstance(oOwner),
                   "CoGVehicle Owner must be a class instance or null.");
            assert(sEventrixEnvironment == nil or rawtype(sEventrixEnvironment) == "string",
                   "CoGVehicle event environment must be a name or nil.");



            -- Preserve supplied object identities and allocate defaults only when omitted.
            local pro = this;

            pro.Components          = tSlots;
            pro.DistancePerFuelUnit = nDistancePerFuelUnit;
            pro.Exclusive           = bExclusive;
            pro.Fuel                = oFuel or Pool();
            pro.Inimitable          = bInimitable;
            pro.MaxSpeed            = nMaxSpeed;
            pro.Owner               = oOwner or null;
            pro.Quest               = bQuest;
            pro.Tradeable           = bTradable;
            pro.Unmanned            = bUnmanned;
            pro.Value               = nValue;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getDistancePerFuelUnit
            @pulsarlua function CoGVehicle.getDistancePerFuelUnit
            @desc Returns the stored DistancePerFuelUnit value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret number vValue Stored value/reference.
        !]]
        public getDistancePerFuelUnit() {
            return this.DistancePerFuelUnit;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.isExclusive
            @pulsarlua function CoGVehicle.isExclusive
            @desc Returns the stored Exclusive value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret boolean vValue Stored value/reference.
        !]]
        public isExclusive() {
            return this.Exclusive;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.isInimitable
            @pulsarlua function CoGVehicle.isInimitable
            @desc Returns the stored Inimitable value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret boolean vValue Stored value/reference.
        !]]
        public isInimitable() {
            return this.Inimitable;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getMaxSpeed
            @pulsarlua function CoGVehicle.getMaxSpeed
            @desc Returns the stored MaxSpeed value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret number vValue Stored value/reference.
        !]]
        public getMaxSpeed() {
            return this.MaxSpeed;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getOwner
            @pulsarlua function CoGVehicle.getOwner
            @desc Returns the stored Owner value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret object|null vValue Stored value/reference.
        !]]
        public getOwner() {
            return this.Owner;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.isQuest
            @pulsarlua function CoGVehicle.isQuest
            @desc Returns the stored Quest value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret boolean vValue Stored value/reference.
        !]]
        public isQuest() {
            return this.Quest;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.isUnmanned
            @pulsarlua function CoGVehicle.isUnmanned
            @desc Returns the stored Unmanned value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret boolean vValue Stored value/reference.
        !]]
        public isUnmanned() {
            return this.Unmanned;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getValue
            @pulsarlua function CoGVehicle.getValue
            @desc Returns the stored Value value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret number vValue Stored value/reference.
        !]]
        public getValue() {
            return this.Value;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getFuelPool
            @pulsarlua function CoGVehicle.getFuelPool
            @desc Returns the stored Fuel value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret Pool vValue Stored value/reference.
        !]]
        public getFuelPool() {
            return this.Fuel;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.setComponent
            @desc Validates the slot and object before replacing the binding. Nil or
            null clears a slot. Shared components are allowed; a binding does not
            confer exclusive ownership of the component object.
            @param string|CoGVehicle.COMPONENT vComponent The configured slot.
            @param object|null|nil oComponent A class instance or an empty-slot value.
            @ret CoGVehicle this The vehicle for chaining.
        !]]
        public setComponent(vComponent, oComponent) {
            local sName = CoGVehicle.componentName(vComponent);

            oComponent = oComponent == nil and null or oComponent;
            CoGVehicle.validateComponent(oComponent);

            this.Components[sName] = oComponent;

            return this;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getComponents
            @desc Copies slot bindings while retaining component object identities.
            Editing the returned table does not change the vehicle's slot bindings.
            @ret table tComponents Configured names mapped to objects or null.
        !]]
        public getComponents() {
            local tComponents = {};

            for sName, oComponent in pairs(this.Components) do
                tComponents[sName] = oComponent;
            end

            return tComponents;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.isTradable
            @pulsarlua function CoGVehicle.isTradable
            @desc Returns the stored Tradable value/reference. Non-final getter; no public replacement setter. Flags are caller-enforced metadata.
            @ret boolean vValue Stored value/reference.
        !]]
        public isTradable() {
            return this.Tradeable;
        }

        --[[!
            @fqxn CoG.CoGVehicle.Methods.getComponent
            @desc Returns the actual component in a configured slot, or null if empty.
            @param string|CoGVehicle.COMPONENT vComponent The configured slot.
            @ret object|null oComponent The stored reference or null.
        !]]
        public getComponent(vComponent) {
            return this.Components[CoGVehicle.componentName(vComponent)];
        }

        --[[!
        @fqxn CoG.CoGVehicle.Operators.clone
        @desc Rejects implicit copying; concrete subclasses provide their own clone
            operator for vehicle state, components, owners, affixes and callbacks.
        !]]
        public operator clone() {
            error("CoGVehicle subclasses must implement clone for their vehicle state.");
        }

        --[[!
        @fqxn CoG.CoGVehicle.validateSnapshot
        @desc Validates restored fuel, measurements, flags, owner and complete slot
            bindings without rerunning constructors or changing shared identities.
        !]]
        private validateSnapshot(state) {
            local pro = state.pro;
            assert(class.isa(pro.Fuel, Pool), "Invalid saved vehicle fuel.");
            CoGVehicle.validateNumber(pro.DistancePerFuelUnit, "DistancePerFuelUnit");
            CoGVehicle.validateNumber(pro.MaxSpeed, "MaxSpeed");
            CoGVehicle.validateNumber(pro.Value, "Value");

            for _, sField in ipairs({"Exclusive", "Inimitable", "Quest", "Tradeable", "Unmanned"}) do
                assert(rawtype(pro[sField]) == "boolean", "Invalid saved vehicle flag: "..sField);
            end

            assert(type.isnull(pro.Owner) or class.isinstance(pro.Owner), "Invalid saved vehicle owner.");
            type.assert.table(pro.Components);

            for sName, oComponent in pairs(pro.Components) do
                assert(rawtype(sName) == "string", "Saved vehicle slots must use configured names.");
                CoGVehicle.componentName(sName);
                CoGVehicle.validateComponent(oComponent);
            end

            local eComponents = CoGVehicle.COMPONENT;

            for _, eComponent in eComponents() do
                assert(pro.Components[eComponent.Name] ~= nil, "Saved vehicle component slot is missing.");
            end
        }
    }
}

