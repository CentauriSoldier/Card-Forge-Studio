<Type>0</Type>
<Name>btn Window Test</Name>
<VisibleAtDesignTime>1</VisibleAtDesignTime>
<VisibleAtRunTime>1</VisibleAtRunTime>
<Locked>0</Locked>
<Enabled>1</Enabled>
<ToolTip/>
<Cursor>1</Cursor>
<Group>0</Group>
<MaintainAspectRatio>0</MaintainAspectRatio>
<Pin>0</Pin>
<TabIndex>-1</TabIndex>
<AutoResize>0</AutoResize>
<Coordinates>
<Top>137</Top>
<Bottom>192</Bottom>
<Left>27</Left>
<Right>277</Right>
</Coordinates>
<Ratios>
<WidthRatio>-1.000000</WidthRatio>
<HeightRatio>-1.000000</HeightRatio>
</Ratios>
<Event>
<Name>On Click</Name>
<Args/>
<Script>local S = Windows.WINDOW_STYLE


hWND_TEST = WindowWizard.CreateTopWindowEx(
    "WindowWizard Test",
    100, 100,
    800, 600,
    S.WS_OVERLAPPED | S.WS_SYSMENU | S.WS_MINIMIZEBOX | S.WS_THICKFRAME,
    S.CW_USEDEFAULT, S.CW_USEDEFAULT, 0,
    nil, nil
)

-- Helper to log to UI
local function log(msg)
    Paragraph.SetText("par 1", msg)
end

local function log2(msg)
    Paragraph.SetText("par 2", msg)
end

-- ======================
-- LIFECYCLE
-- ======================

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnReady", function(hwnd)
    log(hwnd .. " Ready")
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnClose", function(hwnd)
    log(hwnd .. " Close requested")
    return true -- allow close
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnDestroy", function(hwnd)
    log(hwnd .. " Destroyed")
end)

-- ======================
-- RESIZE
-- ======================

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnResize", function(hwnd, w, h)
    log(hwnd .. " Resize: " .. w .. "x" .. h)
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnResizeStart", function(hwnd, w, h)
    log(hwnd .. " Resize START @ " .. w .. "x" .. h)
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnResizeStop", function(hwnd, w, h)
    log(hwnd .. " Resize STOP @ " .. w .. "x" .. h)
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnMinimize", function(hwnd)
    log(hwnd .. " Minimized")
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnRestore", function(hwnd)
    log(hwnd .. " Restored")
end)

WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnMaximize", function(hwnd)
    log(hwnd .. " Maximized")
end)

-- ======================
-- KEYBOARD
-- ======================

-- OnKey(hwnd, vk, down, ctrl, shift, alt)
WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnKey", function(
    hwnd, vk, down, ctrl, shift, alt
)
    log(
        hwnd ..
        " Key vk=" .. vk ..
        " down=" .. down ..
        " ctrl=" .. ctrl ..
        " shift=" .. shift ..
        " alt=" .. alt
    )
end)

-- ======================
-- MOUSE
-- ======================

-- OnMouseButton(
--   hwnd, button, down, x, y,
--   ctrl, shift, alt,
--   lDown, rDown, mDown, x1Down, x2Down
-- )
WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnMouseButton", function(
    hwnd, btn, down, x, y,
    ctrl, shift, alt,
    l, r, m, x1, x2
)
    log(
        hwnd ..
        " Mouse " .. btn ..
        " down=" .. down ..
        " @ " .. x .. "," .. y
    )
end)

-- OnMouseWheel(hwnd, delta, x, y, ctrl, shift, alt, lDown, rDown, mDown, x1Down, x2Down)
WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnMouseWheel", function(
    hwnd, delta, x, y,
    ctrl, shift, alt,
    l, r, m, x1, x2
)
    log(
        hwnd ..
        " Wheel delta=" .. delta ..
        " @ " .. x .. "," .. y
    )
end)

-- OnEnter(hwnd, x, y, lDown, rDown, mDown, x1Down, x2Down)
WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnEnter", function(
    hwnd, x, y, l, r, m, x1, x2
)
    log(hwnd .. " Mouse ENTER @ " .. x .. "," .. y)
end)

-- OnLeave(hwnd, lDown, rDown, mDown, x1Down, x2Down)
WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnLeave", function(
    hwnd, l, r, m, x1, x2
)
    log(hwnd .. " Mouse LEAVE")
end)

-- OnLeave(hwnd, lDown, rDown, mDown, x1Down, x2Down)
WindowWizard.SetTopEventHandlerFor(hWND_TEST, "OnMouseMOve", function(
    hwnd, x, y
)
    log2(hwnd .. "X: "..x.." | Y: "..y)
end) 


local hBtn = WindowWizard.CreateChildWindowEx(hWND_TEST, "sdf", "BUTTON", 20, 20, 120, 28, nil, S.WS_CHILD | S.WS_VISIBLE | S.WS_TABSTOP | 0x00000000, 1001)
</Script>
